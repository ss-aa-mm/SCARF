package [packageName/];

import java.io.File;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.*;
import java.util.function.BiConsumer;

import ch.qos.logback.classic.Level;
import ch.qos.logback.classic.LoggerContext;
import org.cloudsimplus.core.CloudSimPlus;
import org.cloudsimplus.datacenters.Datacenter;
import org.cloudsimplus.listeners.EventInfo;
import org.cloudsimplus.resources.PeSimple;
import org.cloudsimplus.schedulers.cloudlet.CloudletSchedulerSpaceShared;
import org.cloudsimplus.schedulers.cloudlet.CloudletSchedulerTimeShared;
import org.cloudsimplus.util.Log;
import org.cloudsimplus.utilizationmodels.UtilizationModelDynamic;
import org.cloudsimplus.utilizationmodels.UtilizationModelFull;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

public class [name/] {

	private static final Logger log = LoggerFactory.getLogger([name/].class);
	private final int USER_TYPES = [UMLModel.eContents(uml::Activity) -> size()/];
	private final ActivityNode['[]'/] userActivityGraphs = new ActivityNode['['/]USER_TYPES[']'/];
	final ArrayList<ScarfHost> hostList;
	final ArrayList<User> currentRepUsers;
	static String basePath;

	static {
        Log.setLevel(Level.WARN);
        LoggerContext ctx = (LoggerContext) LoggerFactory.getILoggerFactory();
        ctx.getLogger("[packageName/]").setLevel(Level.INFO);
    }

	public static void main(String['[]'/] args) {
		basePath = (args.length > 0) ? args['[0]'/] : ".";
		ScarfGlobalSummary out = new ScarfGlobalSummary(new Metadata("[UMLModel.name.metadataSafe()/]", [repetitions/], "[dist + '(' + p1 + ', ' + p2 + ')'/]"));
		Log.setLevel(ch.qos.logback.classic.Level.WARN);
		for(int i = 0; i < Utils.REPETITIONS; i++) {
			[name/] r = new [name/](i + 1);
			out.merge(new ScarfSimulationSummary(r.currentRepUsers, r.hostList));
		}

		ObjectMapper mapper = new ObjectMapper();
		mapper.enable(SerializationFeature.INDENT_OUTPUT);
		
		try {
			mapper.writeValue(new File(basePath, "[packageName/]_plot.json"), out);
		} catch (IOException e) {
			log.error(e.getMessage());
		}

		Log.setLevel(ch.qos.logback.classic.Level.INFO);
	}

	private [name/](int rep) {
		CloudSimPlus simulation = new CloudSimPlus();
		ScarfDatacenterBroker broker = new ScarfDatacenterBroker(simulation, this);

		[let devices : Sequence(uml::Device) = UMLModel.eAllContents(uml::Device) -> select(dev | not dev.getAppliedStereotype('sciuml::CarbonEmittingDevice').oclIsUndefined())]
		[let executionEnvironments : Sequence(uml::ExecutionEnvironment) = devices -> collectNested(eContents(uml::ExecutionEnvironment)) -> flatten() -> select(env | not env.getAppliedStereotype('sciuml::CarbonEmittingEE').oclIsUndefined())]
		[let regions : Set(String) = devices -> collect(d | d.getValue(d.getAppliedStereotype('sciuml::CarbonEmittingDevice'), 'region')).oclAsType(uml::EnumerationLiteral).name -> asSet()]
		hostList = new ArrayList<>([devices -> size()/]);
		ArrayList<ScarfCloudlet> cloudletList = new ArrayList<>();
		ArrayList<ScarfVm> newVms;
		ArrayList<ScarfHost> newHosts;
		ScarfHost host;
		ScarfVm vm;
		Datacenter datacenter;

		[for (region : String | regions)]
		[let regionalDevices : Sequence(uml::Device) = devices -> select(d | d.getValue(d.getAppliedStereotype('sciuml::CarbonEmittingDevice'), 'region').oclAsType(uml::EnumerationLiteral).name = region)]
		newHosts = new ArrayList<>([regionalDevices -> size()/]);
		newVms = new ArrayList<>([regionalDevices -> collectNested(eContents(uml::ExecutionEnvironment)) -> flatten() -> select(env | not env.getAppliedStereotype('sciuml::CarbonEmittingEE').oclIsUndefined()) -> size()/]);
		[for (device : uml::Device | regionalDevices)]
		[let ds : uml::Stereotype = device.getAppliedStereotype('sciuml::CarbonEmittingDevice')]
		host = new ScarfHost("[device.name.safe()/]", [device.getValue(ds, 'ram')/], [device.getValue(ds, 'bandwidth')/], [device.getValue(ds, 'storage')/], [for (n : Integer | Sequence{1..(device.getValue(ds, 'CoresPerCPU').oclAsType(Integer) * device.getValue(ds, 'CPUs').oclAsType(Integer))}) before('List.of(') separator(', ') after('),')]new PeSimple([device.getValue(ds, 'MIPS').oclAsType(Integer)/] / Utils.UNITS_OF_TIME_PER_SECOND)[/for] [device.getValue(ds, 'embodiedEmissions').oclAsType(Real)/], [device.getValue(ds, 'expectedLifespan').oclAsType(Real)/], [device.getValue(ds, 'thermalDesignPowerPerCPU').oclAsType(Real) * device.getValue(ds, 'CPUs').oclAsType(Integer)/]);
		newHosts.add(host);
		[for (ee : uml::ExecutionEnvironment | device.eContents(uml::ExecutionEnvironment) -> select(env | not env.getAppliedStereotype('sciuml::CarbonEmittingEE').oclIsUndefined()))]
		[let es : uml::Stereotype = ee.getAppliedStereotype('sciuml::CarbonEmittingEE')]
		[let component : String = device.eContents(uml::Artifact) -> select(a | ee.eContents(uml::Deployment) -> any(true).deployedArtifact -> includes(a)) -> collectNested(manifestation) -> flatten() -> any(true).utilizedElement.name]
		[let tierNames : OclAny = ee.getValue(es, 'allowedTiers')]
		vm = new ScarfVm("[ee.name.safe()/]", [ee.getValue(es, 'MIPS').oclAsType(Integer)/] / Utils.UNITS_OF_TIME_PER_SECOND, [ee.getValue(es, 'reservedCores')/], "[component/]", host, List.of([for(tier : OclAny | tierNames) separator(', ')]"[tier.eGet('name')/]"[/for]));
		vm.setRam([ee.getValue(es, 'ram')/]);
		vm.setBw([ee.getValue(es, 'bandwidth')/]);
		vm.setSize([ee.getValue(es, 'capacity')/]);
		vm.setCloudletScheduler(new CloudletScheduler[if (ee.getValue(es, 'deploymentPolicy').oclAsType(uml::EnumerationLiteral).name = 'Silo')]Space[else]Time[/if]Shared());
		broker.registerVm("[component/]", vm);
		newVms.add(vm);
		[/let] [comment tierNames /]
		[/let] [comment component /]
		[/let] [comment es /]
		[/for] [comment ee /]
		[/let] [comment ds /]
		[/for] [comment device /]
		[/let] [comment regionalDevices /]
		
		datacenter = new ScarfDatacenter(simulation, newHosts, "[region/]");
		datacenter.setName("[(name + '_' + region).safe()/]");
		broker.submitVmList(newVms);
		hostList.addAll(newHosts);
		[/for] [comment region /]
		[/let] [comment regions /]
		[/let] [comment executionEnvironments /]
		[/let] [comment devices /]

		Map<String, TriConsumer<EventInfo, User, BiConsumer<EventInfo, User>>> interactions = new HashMap<>();
		interactions.put("Nop", (evt, user, next) -> next.accept(evt, user));
		interactions.put("Sink", (_, _, _) -> {});

		[for (interaction: uml::Interaction | UMLModel.eContents(uml::Interaction)) separator('\n')]
		interactions.put("[interaction.name.safe()/]", (_, user, next) -> {
			[let cloudletsEntryPoints : Sequence(uml::OccurrenceSpecification) = interaction.eContents(uml::OccurrenceSpecification)
				-> select(o | o.isStarting())]
			ArrayList<ScarfCloudlet> newCloudlets = new ArrayList<>([cloudletsEntryPoints -> size()/]);
			[let initialEntryPoint : uml::OccurrenceSpecification = cloudletsEntryPoints -> select(ep | ep.oclIsTypeOf(uml::ExecutionOccurrenceSpecification)) -> any(true)]
			[initialEntryPoint.generateInteraction(initialEntryPoint.followingCloudletStart(), UMLModel.eAllContents(uml::ExecutionEnvironment))/]
			[/let] [comment initialEntryPoint /]
			[/let] [comment cloudletsEntryPoints /]
			cloudletList.addAll(newCloudlets);
		});
		[/for] [comment interaction /]

		int graphsIndex = -1;

		[for(activity : uml::Activity | UMLModel.eContents(uml::Activity)) separator('\n')]
		[for(node : uml::ActivityNode | activity.node)]
		[let nodeName : String = activity.name.safe() + node.name.safe()]
		ActivityNode [nodeName/] = new ActivityNode(interactions.get("[if(node.oclIsTypeOf(uml::CallBehaviorAction))][node.oclAsType(uml::CallBehaviorAction).behavior.name.safe()/][else][if(node.oclIsTypeOf(uml::ActivityFinalNode))]Sink[else]Nop[/if][/if]"));
		[if(node.oclIsTypeOf(uml::InitialNode))]
		userActivityGraphs['['/]++graphsIndex[']'/] = [nodeName/];
		[/if]
		[/let] [comment nodeName /]
		[/for] [comment node /]
		[for(arrow : uml::ControlFlow | activity.edge -> selectByType(uml::ControlFlow))]
		[activity.name.safe() + arrow.source.name.safe()/].addChild([activity.name.safe() + arrow.target.name.safe()/][if(not arrow.getAppliedStereotype('sciuml::DecisionFlow').oclIsUndefined())], [arrow.getValue(arrow.getAppliedStereotype('sciuml::DecisionFlow'), 'weight')/][/if]);
		[/for] [comment arrow /]
		[/for] [comment activity /]

		currentRepUsers = new ArrayList<>();
		User.resetIdCount();

		simulation.terminateAt(Utils.EXEC_TIME);
		simulation.start();

		System.out.println("Finished Simulation Repetition #" + rep);
		System.out.println("Executed Cloudlets: " + cloudletList.size());
		System.out.println("Total Cloudlets Teads SCI: " + cloudletList.stream().mapToDouble(ScarfCloudlet::getTeadsSci).sum());
		System.out.println("Total Cloudlets PowerModel SCI: " + cloudletList.stream().mapToDouble(ScarfCloudlet::getPowerModelSci).sum());
		
		try {
			Files.write(Path.of(basePath, "[packageName/]_" + rep + ".txt"), currentRepUsers.stream().map(Object::toString).toList(), StandardCharsets.UTF_8);
			List<String> traceReplay = new ArrayList<>();
			traceReplay.add("time,device,interaction");
			traceReplay.addAll(currentRepUsers.stream()
			    .flatMap(u -> u.getExecutedCloudlets().stream())
			    .filter(ScarfCloudlet::isInitial)
			    .sorted(Comparator.comparingDouble(ScarfCloudlet::getStartTime))
			    .map(ScarfCloudlet::toString)
			    .toList());
			Files.write(Path.of(basePath, "[packageName/]_" + rep + "_tr.csv"), traceReplay);
		} catch (IOException e) {
			log.error(e.getMessage());
		}
	}

	ActivityNode randomUserType() {
		return this.userActivityGraphs['['/]Utils.rng.nextInt(USER_TYPES)[']'/];
	}

	void addUser(User user) {
        this.currentRepUsers.add(user);
    }
}
