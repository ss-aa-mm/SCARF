[template public iatFormula(dist : String, p1 : Real, p2 : Real)]
[if (dist = 'Exponential')](-Math.log(1 - Utils.rng.nextDouble()) / [p1/]) * Utils.UNITS_OF_TIME_PER_SECOND;
[elseif (dist = 'Uniform')]([p1/] + ([p2/] - [p1/]) * Utils.rng.nextDouble()) * Utils.UNITS_OF_TIME_PER_SECOND;
[elseif (dist = 'Constant')][p1/] * Utils.UNITS_OF_TIME_PER_SECOND;
[elseif (dist = 'Erlang')]0;
for(int i = 0; i < [p1.round()/]; i++) {
	iat += (-Math.log(1 - Utils.rng.nextDouble()) / [p2/]) * Utils.UNITS_OF_TIME_PER_SECOND;
}
[else][comment Lognormal or Log-normal /](Math.exp(Utils.rng.nextGaussian() * [p1/] + [p2/])) * Utils.UNITS_OF_TIME_PER_SECOND;
[/if]
[/template]


[query public safe(s : String) : String = s.toUpperFirst().replaceAll('[^A-Za-z0-9_]', '')/]
[query public metadataSafe(s : String) : String = s.toUpperFirst().replaceAll('[^A-Za-z0-9_-]', '')/]

[query public isStarting(os : uml::OccurrenceSpecification) : Boolean =
	let oss : uml::Stereotype = os.getAppliedStereotype('sciuml::TaskSpecification') in
	if oss.oclIsUndefined() then
		false
	else
		let exMIs : Integer = os.getValue(oss, 'executedMIs').oclAsType(Integer) in
		exMIs = 0
	endif
/]

[query public canBeEnd(os : uml::OccurrenceSpecification) : Boolean =
	os.oclIsTypeOf(uml::ExecutionOccurrenceSpecification)
	or
	os.eContainer(uml::Interaction).eContents(uml::Message)
	-> reject(m | m.messageSort = uml::MessageSort::asynchCall)
	-> collectNested(sendEvent)
	-> includes(os)
/]

[query public events(ll : uml::Lifeline) : OrderedSet(uml::OccurrenceSpecification) =
	ll.interaction.fragment -> selectByKind(uml::OccurrenceSpecification)-> select (os | os.covered -> includes(ll)) -> asOrderedSet()
/]

[query public cloudletEnd(o : uml::OccurrenceSpecification) : uml::OccurrenceSpecification =
	if o.isStarting() then
		let currentLifeline : uml::Lifeline = o.eContainer(uml::Interaction).eContents(uml::Lifeline) -> select(l | l.events() -> includes(o)) -> any(true) in
		if currentLifeline.oclIsUndefined() then
			null
		else
			let covereds : OrderedSet(uml::OccurrenceSpecification) = currentLifeline.events() in
			let successors : OrderedSet(uml::OccurrenceSpecification) = covereds -> subOrderedSet(covereds -> indexOf(o), covereds -> size()) -> excluding(o) -> asOrderedSet() in
			if successors -> oclIsUndefined() then
				null
			else
				successors -> select(os | os.canBeEnd()) -> first()
			endif
		endif
	else
		null
	endif	
/]

[query public followingCloudletStart(o : uml::OccurrenceSpecification) : uml::OccurrenceSpecification =
	let currentEnd : uml::OccurrenceSpecification = if o.isStarting() then o.cloudletEnd() else o endif in
	let involvedMessage : uml::Message = o.eContainer(uml::Interaction).eContents(uml::Message)
		-> select(m | m.sendEvent = currentEnd)
		-> any(true) in
	if involvedMessage.oclIsUndefined() then
		null
	else
		involvedMessage.receiveEvent.oclAsType(uml::OccurrenceSpecification)
	endif
/]
