[comment encoding = UTF-8 /]
[module main('http://www.eclipse.org/uml2/5.0.0/UML')]

[template public projectGenerator(
    UMLModel : uml::Model,
    repetitions : Integer,
    dist : String,
    p1 : Real,
    p2 : Real,
    startTimeHours : Integer,
    startTimeMinutes : Integer,
    durationInHours : Integer,
    referencePeriod : String,
    alpha : Real
)]
[comment @main/]
[let name : String = UMLModel.name.toLowerCase().safe()]
[let packageName : String = name.toLowerCase()]
[let ms : uml::Stereotype = UMLModel.getAppliedStereotype('sciuml::ModelingContext')]
[let referenceMIPS : Integer = UMLModel.getValue(ms, 'referenceProcessor').eGet('MIPS').oclAsType(Integer)]
[file(name + '.java', false, 'UTF-8')]
package [packageName/];

import java.io.File;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.*;
import java.util.function.BiConsumer;

import ch.qos.logback.classic.Level;
import ch.qos.logback.classic.LoggerContext;
import org.cloudsimplus.core.CloudSimPlus;
import org.cloudsimplus.datacenters.Datacenter;
import org.cloudsimplus.listeners.EventInfo;
import org.cloudsimplus.resources.PeSimple;
import org.cloudsimplus.schedulers.cloudlet.CloudletSchedulerSpaceShared;
import org.cloudsimplus.schedulers.cloudlet.CloudletSchedulerTimeShared;
import org.cloudsimplus.schedulers.vm.VmSchedulerTimeShared;
import org.cloudsimplus.util.Log;
import org.cloudsimplus.utilizationmodels.UtilizationModelDynamic;
import org.cloudsimplus.utilizationmodels.UtilizationModelFull;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

public class [name/] {

	private static final Logger log = LoggerFactory.getLogger([name/].class);
	private final int USER_TYPES = [UMLModel.eContents(uml::Activity) -> size()/];
	private final ActivityNode['[]'/] userActivityGraphs = new ActivityNode['['/]USER_TYPES[']'/];
	final ArrayList<ScarfHost> hostList;
	final ArrayList<User> currentRepUsers;
	static String basePath;

	static {
        Log.setLevel(Level.INFO);
        LoggerContext ctx = (LoggerContext) LoggerFactory.getILoggerFactory();
        ctx.getLogger("[packageName/]").setLevel(Level.INFO);
    }

	public static void main(String['[]'/] args) {
		basePath = (args.length > 0) ? args['[0]'/] : ".";
		ScarfGlobalSummary out = new ScarfGlobalSummary(new Metadata("[UMLModel.name.metadataSafe()/]", [repetitions/], "[dist + '(' + p1/][if (not p2.oclIsUndefined() and p2.toString() <> 'NaN')], [p2/][/if])"));
		for(int i = 0; i < Utils.REPETITIONS; i++) {
			[name/] r = new [name/](i + 1);
			out.merge(new ScarfSimulationSummary(r.currentRepUsers, r.hostList));
		}

		ObjectMapper mapper = new ObjectMapper();
		mapper.registerModule(new JavaTimeModule());
		mapper.enable(SerializationFeature.INDENT_OUTPUT);
		
		try {
			mapper.writeValue(new File(basePath, "[packageName/]_plot.json"), out);
		} catch (IOException e) {
			log.error(e.getMessage());
		}

        System.out.println("Max Heap Memory (MB): " + (Runtime.getRuntime().maxMemory() / (1024 * 1024)));
		Log.setLevel(Level.INFO);
		Utils.rng.setSeed(Utils.SEED);
        Utils.arrivalRng.setSeed(Utils.SEED);
	}

	private [name/](int rep) {
		CloudSimPlus simulation = new CloudSimPlus(0.001);
		ScarfDatacenterBroker broker = new ScarfDatacenterBroker(simulation, this);

		[let devices : Sequence(uml::Device) = UMLModel.eAllContents(uml::Device) -> select(dev | not dev.getAppliedStereotype('sciuml::CarbonEmittingDevice').oclIsUndefined())]
		[let executionEnvironments : Sequence(uml::ExecutionEnvironment) = devices -> collectNested(eContents(uml::ExecutionEnvironment)) -> flatten() -> select(env | not env.getAppliedStereotype('sciuml::CarbonEmittingEE').oclIsUndefined())]
		[let regions : Set(String) = devices -> collect(d | d.getValue(d.getAppliedStereotype('sciuml::CarbonEmittingDevice'), 'region')).oclAsType(uml::EnumerationLiteral).name -> asSet()]
		hostList = new ArrayList<>([devices -> size()/]);
		ArrayList<ScarfVm> newVms;
		ArrayList<ScarfHost> newHosts;
		ScarfHost host;
		ScarfVm vm;
		Datacenter datacenter;

		[for (region : String | regions)]
		[let regionalDevices : Sequence(uml::Device) = devices -> select(d | d.getValue(d.getAppliedStereotype('sciuml::CarbonEmittingDevice'), 'region').oclAsType(uml::EnumerationLiteral).name = region)]
		newHosts = new ArrayList<>([regionalDevices -> size()/]);
		newVms = new ArrayList<>([regionalDevices -> collectNested(eContents(uml::ExecutionEnvironment)) -> flatten() -> select(env | not env.getAppliedStereotype('sciuml::CarbonEmittingEE').oclIsUndefined()) -> size()/]);
		[for (device : uml::Device | regionalDevices)]
		[let ds : uml::Stereotype = device.getAppliedStereotype('sciuml::CarbonEmittingDevice')]
		[let vCores : Integer = device.getValue(ds, 'CoresPerCPU').oclAsType(Integer) * device.getValue(ds, 'CPUs').oclAsType(Integer)]
		host = new ScarfHost("[device.name.safe()/]", [device.getValue(ds, 'ram')/], [device.getValue(ds, 'bandwidth')/], [device.getValue(ds, 'storage')/], [for (n : Integer | Sequence{1..vCores}) before('List.of(') separator(', ') after('),')]new PeSimple([device.getValue(ds, 'speedFactor').oclAsType(Real) * referenceMIPS/] / Utils.UNITS_OF_TIME_PER_SECOND)[/for] [device.getValue(ds, 'embodiedEmissions').oclAsType(Real)/], [device.getValue(ds, 'expectedLifespan').oclAsType(Real)/], [device.getValue(ds, 'thermalDesignPowerPerCPU').oclAsType(Real) * device.getValue(ds, 'CPUs').oclAsType(Integer)/], ['EdgeNode'.getIdlePowerFactor()/]);
		[let childrenEE : Sequence(uml::ExecutionEnvironment) = device.eContents(uml::ExecutionEnvironment) -> select(env | not env.getAppliedStereotype('sciuml::CarbonEmittingEE').oclIsUndefined())]
		[if (vCores < childrenEE -> collect(eenv | eenv.getValue(eenv.getAppliedStereotype('sciuml::CarbonEmittingEE'), 'reservedCores').oclAsType(Integer)) -> sum())]
		host.setVmScheduler(new VmSchedulerTimeShared());
		[/if]
		newHosts.add(host);
		[for (ee : uml::ExecutionEnvironment | childrenEE)]
		[let es : uml::Stereotype = ee.getAppliedStereotype('sciuml::CarbonEmittingEE')]
		[let component : String = device.eContents(uml::Artifact) -> select(a | ee.eContents(uml::Deployment) -> any(true).deployedArtifact -> includes(a)) -> collectNested(manifestation) -> flatten() -> any(true).utilizedElement.name]
		[let tierNames : OclAny = ee.getValue(es, 'allowedTiers')]
		vm = new ScarfVm("[ee.name.safe()/]", [ee.getValue(es, 'speedFactor').oclAsType(Real) * referenceMIPS/] / Utils.UNITS_OF_TIME_PER_SECOND, [ee.getValue(es, 'reservedCores')/], "[component/]", host, List.of([for(tier : OclAny | tierNames) separator(', ')]"[tier.eGet('name')/]"[/for]));
		vm.setRam([ee.getValue(es, 'ram')/]);
		vm.setBw([ee.getValue(es, 'bandwidth')/]);
		vm.setSize([ee.getValue(es, 'capacity')/]);
		[let depPolicy: String = ee.getValue(es, 'deploymentPolicy').oclAsType(uml::EnumerationLiteral).name]
		vm.setPriority([if (depPolicy.substring(1, 4) = 'Silo')]true[else]false[/if]);
		vm.setIsolationThreshold([if (depPolicy = 'SiloBestEffort')]0.85[else]1.0[/if]);
		[comment At present, using different cloudlet scheduler types is extremely unstable and thus it is better if avoided /]
		vm.setCloudletScheduler(new CloudletSchedulerSpaceShared());
		[/let] [comment depPolicy /]
		broker.registerVm("[component/]", vm);
		newVms.add(vm);
		[/let] [comment tierNames /]
		[/let] [comment component /]
		[/let] [comment es /]
		[/for] [comment ee /]
		[/let] [comment childrenEE /]
		[/let] [comment vCores /]
		[/let] [comment ds /]
		[/for] [comment device /]
		[/let] [comment regionalDevices /]
		
		datacenter = new ScarfDatacenter(simulation, newHosts, "[region/]");
		datacenter.setName("[(name + '_' + region).safe()/]");
		broker.submitVmList(newVms);
		hostList.addAll(newHosts);
		[/for] [comment region /]
		[/let] [comment regions /]
		[/let] [comment executionEnvironments /]
		[/let] [comment devices /]

		Map<String, TriConsumer<EventInfo, User, BiConsumer<EventInfo, User>>> interactions = new HashMap<>();
		interactions.put("Nop", (evt, user, next) -> next.accept(evt, user));
		interactions.put("Sink", (_, _, _) -> {});

		[for (interaction: uml::Interaction | UMLModel.eContents(uml::Interaction)) separator('\n')]
		interactions.put("[interaction.name.safe()/]", (_, user, next) -> {
			[let cloudletsEntryPoints : Sequence(uml::OccurrenceSpecification) = interaction.eContents(uml::OccurrenceSpecification)
				-> select(o | o.isStarting())]
			[let initialEntryPoint : uml::OccurrenceSpecification = cloudletsEntryPoints -> select(ep | ep.oclIsTypeOf(uml::ExecutionOccurrenceSpecification)) -> any(true)]
			[initialEntryPoint.generateInteraction(initialEntryPoint.followingCloudletStart(), UMLModel.eAllContents(uml::ExecutionEnvironment), referenceMIPS)/]
			[/let] [comment initialEntryPoint /]
			[/let] [comment cloudletsEntryPoints /]
		});
		[/for] [comment interaction /]

		int graphsIndex = -1;

		[for(activity : uml::Activity | UMLModel.eContents(uml::Activity)) separator('\n')]
		[for(node : uml::ActivityNode | activity.node)]
		[let nodeName : String = activity.name.safe() + node.name.safe()]
		ActivityNode [nodeName/] = new ActivityNode(interactions.get("[if(node.oclIsTypeOf(uml::CallBehaviorAction))][node.oclAsType(uml::CallBehaviorAction).behavior.name.safe()/][else][if(node.oclIsTypeOf(uml::ActivityFinalNode))]Sink[else]Nop[/if][/if]"));
		[if(node.oclIsTypeOf(uml::InitialNode))]
		userActivityGraphs['['/]++graphsIndex[']'/] = [nodeName/];
		[/if]
		[/let] [comment nodeName /]
		[/for] [comment node /]
		[for(arrow : uml::ControlFlow | activity.edge -> selectByType(uml::ControlFlow))]
		[activity.name.safe() + arrow.source.name.safe()/].addChild([activity.name.safe() + arrow.target.name.safe()/][if(not arrow.getAppliedStereotype('sciuml::DecisionFlow').oclIsUndefined())], [arrow.getValue(arrow.getAppliedStereotype('sciuml::DecisionFlow'), 'weight')/][/if]);
		[/for] [comment arrow /]
		[/for] [comment activity /]

		currentRepUsers = new ArrayList<>();
		User.resetIdCount();

		simulation.terminateAt(Utils.EXEC_TIME);
		simulation.start();

		log.info("Finished Simulation Repetition #{}", rep);
		log.info("Executed Cloudlets: {}", currentRepUsers.stream().mapToLong(u -> u.getExecutedCloudlets().size()).sum());
        log.info("Total Cloudlets Teads SCI: {}", currentRepUsers.stream().flatMap(u -> u.getExecutedCloudlets().stream()).mapToDouble(ScarfCloudlet::getTeadsSci).sum());
        log.info("Total Cloudlets PowerModel SCI: {}", currentRepUsers.stream().flatMap(u -> u.getExecutedCloudlets().stream()).mapToDouble(ScarfCloudlet::getPowerModelSci).sum());
		
		try {
			Files.write(Path.of(basePath, "[packageName/]_" + rep + ".txt"), currentRepUsers.stream().map(Object::toString).toList(), StandardCharsets.UTF_8);
			List<String> traceReplay = new ArrayList<>();
			traceReplay.add("time,device,interaction");
			traceReplay.addAll(currentRepUsers.stream()
			    .flatMap(u -> u.getExecutedCloudlets().stream())
			    .filter(ScarfCloudlet::isInitial)
			    .sorted(Comparator.comparingDouble(ScarfCloudlet::getStartTime))
			    .map(ScarfCloudlet::toTraceRow)
			    .toList());
			Files.write(Path.of(basePath, "[packageName/]_" + rep + "_tr.csv"), traceReplay);
		} catch (IOException e) {
			log.error(e.getMessage());
		}
	}

	ActivityNode randomUserType() {
		return this.userActivityGraphs['['/]Utils.rng.nextInt(USER_TYPES)[']'/];
	}

	void addUser(User user) {
        this.currentRepUsers.add(user);
    }
}
[/file]
[file('Utils.java', false, 'UTF-8')]
package [packageName/];

import java.time.OffsetTime;
import java.time.ZoneOffset;
import java.util.*;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.function.BiConsumer;
import java.util.stream.Collectors;

import org.cloudsimplus.allocationpolicies.VmAllocationPolicyAbstract;
import org.cloudsimplus.brokers.DatacenterBroker;
import org.cloudsimplus.brokers.DatacenterBrokerSimple;
import org.cloudsimplus.cloudlets.Cloudlet;
import org.cloudsimplus.cloudlets.CloudletSimple;
import org.cloudsimplus.core.CloudSimPlus;
import org.cloudsimplus.core.events.SimEvent;
import org.cloudsimplus.datacenters.DatacenterSimple;
import org.cloudsimplus.hosts.Host;
import org.cloudsimplus.hosts.HostSimple;
import org.cloudsimplus.listeners.EventInfo;
import org.cloudsimplus.power.models.PowerModelHostSimple;
import org.cloudsimplus.resources.Pe;
import org.cloudsimplus.utilizationmodels.UtilizationModel;
import org.cloudsimplus.vms.Vm;
import org.cloudsimplus.vms.VmSimple;

import com.fasterxml.jackson.annotation.JsonFormat;
import com.fasterxml.jackson.annotation.JsonProperty;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/* DATA */

record CarbonResult(double teadsEstimate, double powerModelEstimate, double embodiedCarbon) {

    public static final CarbonResult ZERO = new CarbonResult(0.0, 0.0, 0.0);

	public CarbonResult add(CarbonResult other) {
		return new CarbonResult(
		    this.teadsEstimate + other.teadsEstimate,
		    this.powerModelEstimate + other.powerModelEstimate,
		    this.embodiedCarbon + other.embodiedCarbon
		);
	}
}

record CarbonSnapshot(double timestamp, double utilization, CarbonResult carbonValues) {}

record InteractionKey(String interaction, String tier) {
	@Override
	public String toString() {
		return interaction() + "|" + tier();
	}
}

class InteractionSeries {
	@JsonProperty("teads_sci")
	public final List<Double> teadsSciValues = new ArrayList<>();
	@JsonProperty("power_model_sci")
	public final List<Double> powerModelSciValues = new ArrayList<>();
	@JsonProperty("embodied_sci")
	public final List<Double> embodiedSciValues = new ArrayList<>();
	@JsonProperty("service_time")
	public final List<Double> serviceTimeValues = new ArrayList<>();
	
	public void addValue(CarbonResult carbon, double time) {
		this.teadsSciValues.add(Utils.sig5(carbon.teadsEstimate()));
		this.powerModelSciValues.add(Utils.sig5(carbon.powerModelEstimate()));
		this.embodiedSciValues.add(Utils.sig5(carbon.embodiedCarbon()));
		this.serviceTimeValues.add(Utils.sig5(time));
	}
}

class HostSeries {
    @JsonProperty("total_cores")
    public final long totalCores;
    @JsonProperty("thermal_design_power")
    public final double thermalDesignPower;
	@JsonProperty("timestamps")
	private final List<Double> timestamps;
	@JsonProperty("average_utilization")
	private final List<Double> avgUtilization;
	@JsonProperty("average_teads_sci")
	private final List<Double> avgTeadsSci;
	@JsonProperty("average_power_model_sci")
	private final List<Double> avgPowerModelSci;
	@JsonProperty("embodied_sci_per_interval")
	private final double embodiedSciPerInterval;
	@JsonProperty("vms")
    public final Map<String, VmSeries> vms;
	
	public HostSeries(ScarfHost host) {
        this.totalCores = host.getPesNumber();
        this.thermalDesignPower = host.getThermalDesignPower();

        List<CarbonSnapshot> trace = host.getCarbonTimeSeries();

        this.timestamps = trace.stream().map(s -> s.timestamp()).toList();
        this.avgUtilization = trace.stream().map(s -> Utils.sig5(s.utilization())).toList();
        this.avgTeadsSci = trace.stream().map(s -> Utils.sig5(s.carbonValues().teadsEstimate())).toList();
        this.avgPowerModelSci = trace.stream().map(s -> Utils.sig5(s.carbonValues().powerModelEstimate())).toList();
        this.embodiedSciPerInterval = trace.isEmpty() ? 0.0
            : Utils.sig5(trace.getFirst().carbonValues().embodiedCarbon());

        this.vms = host.getVmCreatedList().stream()
            .filter(vm -> vm instanceof ScarfVm)
            .collect(Collectors.toMap(
                vm -> ((ScarfVm) vm).getName(),
                vm -> new VmSeries((ScarfVm) vm),
                (a, b) -> a,
                LinkedHashMap::new
            ));
    }
}

class VmSeries {
    @JsonProperty("allocated_cores")
    public final long allocatedCores;
    @JsonProperty("allowed_tiers")
    public final List<String> allowedTiers;
    @JsonProperty("component")
    public final String component;
    @JsonProperty("embodied_sci_per_interval")
    public final double embodiedSciPerInterval;
    @JsonProperty("average_utilization")
    public final List<Double> avgUtilization;
    @JsonProperty("average_teads_sci")
    public final List<Double> avgTeadsSci;
    @JsonProperty("average_power_model_sci")
    public final List<Double> avgPowerModelSci;

    public VmSeries(ScarfVm vm) {
        this.allocatedCores = vm.getPesNumber();
        this.allowedTiers = vm.getAllowedTiers();
        this.component = vm.getComponent();

        List<CarbonSnapshot> series = vm.getCarbonTimeSeries();

        this.avgUtilization = series.stream()
            .map(s -> Utils.sig5(s.utilization()))
            .toList();
        this.avgTeadsSci = series.stream()
            .map(s -> Utils.sig5(s.carbonValues().teadsEstimate()))
            .toList();
        this.avgPowerModelSci = series.stream()
            .map(s -> Utils.sig5(s.carbonValues().powerModelEstimate()))
            .toList();
        this.embodiedSciPerInterval = series.isEmpty() ? 0.0
            : Utils.sig5(series.getFirst().carbonValues().embodiedCarbon());
    }
}

class Metadata {
	@JsonProperty("modelName")
	String expName;
	@JsonProperty("replications")
	int replications;
	@JsonProperty("seed")
	long seed;
	@JsonProperty("arrivalDistributionDetails")
	String distrib;
	@JsonProperty("startTime")
    @JsonFormat(shape = JsonFormat.Shape.STRING, pattern = "HH:mm")
    OffsetTime startTime;
	@JsonProperty("duration")
	double durationInHours;
	@JsonProperty("referencePeriod")
	String referencePeriod;
	@JsonProperty("alpha")
	double alpha;

	public Metadata(String modelName, int replications, String distrib) {
		this.expName = modelName;
		this.replications = replications;
		this.distrib = distrib;
		this.seed = Utils.SEED;
		this.startTime = Utils.SIMULATION_START_TIME_UTC;
		this.durationInHours = (Utils.EXEC_TIME / 3600) / Utils.UNITS_OF_TIME_PER_SECOND;
		this.referencePeriod = Utils.REFERENCE_PERIOD;
		this.alpha = [alpha/];
	}
}

@FunctionalInterface
interface TriConsumer<T, U, V> {
	void accept(T t, U u, V v);
}

/* SIMULATION CLASSES */

class ScarfDatacenter extends DatacenterSimple {
	private final String region;
	private double lastTimeStamp = 0.0;
	private static final double INTERVAL = Utils.UNITS_OF_TIME_PER_SECOND;  // 1 s
	private static final double DEFAULT_GRID_CARBON_INTENSITY = 300.0;

	public ScarfDatacenter(CloudSimPlus simulation, List<ScarfHost> hostList, String region) {
		super(simulation, hostList, new ScarfAllocationPolicy(hostList));
		this.region = region;
	}
	
	@Override
	public void processEvent(SimEvent ev) {
		if(ev.getTag() == Utils.CARBON_SYNC_TAG) {
			runCarbonComputation();
		}
		super.processEvent(ev);
	}

	@Override
	protected void startInternal() {
		super.startInternal();
		this.schedule(this, INTERVAL, Utils.CARBON_SYNC_TAG);
	}

	private void runCarbonComputation() {
		double clock = getSimulation().clock();
		double duration = clock - lastTimeStamp;
		
		for (Host host : getHostList()) {
			ScarfHost sHost = (ScarfHost) host;
			sHost.processIntervalCarbon(clock, duration);
		}
		lastTimeStamp = clock;
		if (clock < Utils.EXEC_TIME) this.schedule(this, INTERVAL, Utils.CARBON_SYNC_TAG);
	}

	public String getRegion() {
		return region;
	}

	public double getGci() {
	    if (Utils.gciData == null) return DEFAULT_GRID_CARBON_INTENSITY;
	    Map<String, double['[]'/]> regionData = Utils.gciData.get(region);
	    if (regionData == null) return DEFAULT_GRID_CARBON_INTENSITY;
	    double['[]'/] periodData = regionData.get(Utils.REFERENCE_PERIOD);
	    if (periodData == null) return DEFAULT_GRID_CARBON_INTENSITY;
	    double clock = this.getSimulation().clock();
	    OffsetTime currentUTCTime = Utils.SIMULATION_START_TIME_UTC.plusSeconds((long) (clock / Utils.UNITS_OF_TIME_PER_SECOND));
	    return periodData['[currentUTCTime.getHour()]'/];
	}
}

class ScarfHost extends HostSimple {
	private final String name;
	private static final double NETWORK_ENERGY = 0.0; // Usually small, simplified to 0 at the moment
	private final double embodiedEmissions;
	private final double expectedLifespan;
	private final double thermalDesignPower;
	private final double idlePowerFactor;
	private final CarbonTracker carbonTracker;

	public ScarfHost(String name, long ram, long bw, long storage, List<Pe> peList, double embodiedEmissions, double expectedLifespan, double thermalDesignPower, double idlePowerFactor) {
		super(ram, bw, storage, peList);
		this.name = name;
		this.embodiedEmissions = embodiedEmissions;
		this.expectedLifespan = expectedLifespan;
		this.thermalDesignPower = thermalDesignPower;
		this.setPowerModel(new PowerModelHostSimple(thermalDesignPower, Math.max(1.0, idlePowerFactor * thermalDesignPower)));
		this.carbonTracker = new CarbonTracker(this, 1.0);
		this.idlePowerFactor = idlePowerFactor;
		//this.enableUtilizationStats();
	}

	public String getName() {
		return name;
	}

	public double getEmbodiedEmissions() {
		return embodiedEmissions;
	}
	
	public double getExpectedLifespan() {
		return expectedLifespan;
	}
	
	public double getThermalDesignPower() {
		return thermalDesignPower;
	}

	public double getNetworkEnergy() {
		return NETWORK_ENERGY;
	}
	
	public double getTeadsSci() {
		return carbonTracker.getTotalCarbon().teadsEstimate();
	}
	
	public double getPowerModelSci() {
		return carbonTracker.getTotalCarbon().powerModelEstimate();
	}

	public double getIdlePowerFactor() {
	    return this.idlePowerFactor;
	}

	public List<CarbonSnapshot> getCarbonTimeSeries() {
		return carbonTracker.getCarbonTimeSeries();
	}

	public void processIntervalCarbon(double clock, double interval) {
		if (interval <= 0.0) return;
		this.carbonTracker.computeSci(clock, interval, this.getCpuPercentUtilization());
		for (Vm vm : this.getVmList()) {
            if (vm instanceof ScarfVm svm) svm.computeSci(clock, interval);
        }
	}

	public void nudgeUtilization(double clock) {
	    this.carbonTracker.updateUtilization(clock, this.getCpuPercentUtilization());
	    for (Vm vm : this.getVmList()) {
	        if (vm instanceof ScarfVm svm) svm.nudgeUtilization(clock);
	    }
	}

	@Override
	public String toString() {
		return name;
	}
}

class ScarfVm extends VmSimple {
	public static final ScarfVm NULL = new ScarfVm("", 0, 1, "", null, Collections.emptyList()) {
		@Override public boolean isCreated() { return false; }
		@Override public String toString() { return "ScarfVm.NULL"; }
	};
	private final String name;
	private final String component;
	private final ScarfHost targetHost;
	private final List<String> allowedTiers;
	private final CarbonTracker carbonTracker;
	private final Integer maxConcurrentUsers;
	private boolean hasPriority;
	private double isolationThreshold;
	
	public ScarfVm(String name, double mipsCapacity, long pesNumber, String component, ScarfHost targetHost, List<String> allowedTiers) {
		super(mipsCapacity, pesNumber);
		this.name = name;
		this.component = component;
		this.targetHost = targetHost;
		this.allowedTiers = allowedTiers;
		this.maxConcurrentUsers = null;
		this.hasPriority = false;
		this.isolationThreshold = 0.0;
		this.carbonTracker = targetHost != null ? new CarbonTracker(targetHost, (double) pesNumber / targetHost.getPesNumber()) : null;
	}

	public ScarfVm(String name, double mipsCapacity, long pesNumber, Integer maxConcurrentUsers, String component, ScarfHost targetHost, List<String> allowedTiers) {
        super(mipsCapacity, pesNumber);
        this.name = name;
        this.component = component;
        this.targetHost = targetHost;
        this.allowedTiers = allowedTiers;
        this.maxConcurrentUsers = maxConcurrentUsers;
        this.hasPriority = false;
        this.isolationThreshold = 0.0;
        this.carbonTracker = targetHost != null ? new CarbonTracker(targetHost, (double) pesNumber / targetHost.getPesNumber()) : null;
    }

	public String getName() {
		return name;
	}

	public Integer getMaxUsers() {
	    return maxConcurrentUsers;
	}

	public long getCurrentUserCount(DatacenterBroker broker) {
        return broker.getCloudletCreatedList().stream()
            .filter(cl -> cl instanceof ScarfCloudlet)
            .map(cl -> (ScarfCloudlet) cl)
            .filter(cl -> cl.getVm().equals(this))
            .filter(cl -> cl.getStatus() == Cloudlet.Status.INEXEC
                       || cl.getStatus() == Cloudlet.Status.QUEUED)
            .map(ScarfCloudlet::getUser)
            .distinct()
            .count();
    }

    public boolean hasUserCapacity(DatacenterBroker broker) {
        return this.maxConcurrentUsers == null || this.getCurrentUserCount(broker) < this.maxConcurrentUsers;
    }

	public double getIsolationThreshold() {
	    return isolationThreshold;
	}

	public boolean hasPriority() {
	    return hasPriority;
	}

	public String getComponent() {
		return component;
	}

	public ScarfHost getTargetHost() {
		return targetHost;
	}
	
	public List<String> getAllowedTiers() {
		return allowedTiers;
	}

	public void setIsolationThreshold(double t) {
	    this.isolationThreshold = t;
	}

	public void setPriority(boolean p) {
	    this.hasPriority = p;
	}

	public void computeSci(double clock, double interval) {
        this.carbonTracker.computeSci(clock, interval, this.getCpuPercentUtilization());
    }

    public List<CarbonSnapshot> getCarbonTimeSeries() {
        return carbonTracker.getCarbonTimeSeries();
    }

    public void nudgeUtilization(double clock) {
        this.carbonTracker.updateUtilization(clock, this.getCpuPercentUtilization());
    }
	
	@Override
	public String toString() {
		return name;
	}
	
}

class ScarfCloudlet extends CloudletSimple {
	private final String name;
	private final User user;
	private final String component;
	private final String interaction;
	private ScarfCloudlet previousCloudlet;
	private boolean initial;
	private CarbonResult totalCarbon = CarbonResult.ZERO;
	
	public ScarfCloudlet(long length, int pesNumber, UtilizationModel utilizationModel, String name, User user, String component, String interaction) {
		super(length, pesNumber, utilizationModel);
		this.name = name;
		this.user = user;
		this.component = component;
		this.interaction = interaction;
		this.initial = false;
		this.previousCloudlet = null;
	}
	
	public String getName() {
		return name;
	}

	public void markAsInitial() {
	    this.initial = true;
	}
	
	public User getUser() {
		return user;
	}

	public String getInteraction() {
		return interaction;
	}

	public String getComponent() {
		return component;
	}

	public double getTeadsSci() {
		return totalCarbon.teadsEstimate();
	}
	
	public double getPowerModelSci() {
		return totalCarbon.powerModelEstimate();
	}

	public double getEmbodiedSci() {
	    return totalCarbon.embodiedCarbon();
	}

	public boolean isInitial() {
        return initial;
	}

	public void setPreviousCloudlet(ScarfCloudlet previous) {
	    this.previousCloudlet = previous;
	}

	public Vm mandatoryExecutionLocation() {
	    if (this.previousCloudlet == null || !this.getComponent().equals(this.previousCloudlet.getComponent()))
	        return null;
	    Vm targetVm = this.previousCloudlet.getVm();
	    return (targetVm == Vm.NULL || targetVm == ScarfVm.NULL) ? null : targetVm;
	}

	@Override
    public String toString() {
        return String.format(Locale.ENGLISH, "["Cloudlet %d [%s, part of %s] (Started: %.3f, Finished: %.3f on %s) {Status: %s} [%d/%d MI]"/]",
            this.getId(), this.getName(), this.interaction, this.getStartTime(), this.getFinishTime(), this.getVm(), this.getStatus(), this.getFinishedLengthSoFar(), this.getTotalLength()
        );
    }

    public String toTraceRow() {
        return String.format(Locale.ENGLISH, "%.3f,%s,%s",
            this.getStartTime() / Utils.UNITS_OF_TIME_PER_SECOND,
            ((ScarfHost) this.getVm().getHost()).getName(),
            this.getInteraction()
        );
    }

	@Override
    public boolean setStatus(final Status status) {
        boolean changed = super.setStatus(status);
        if (changed && status == Status.SUCCESS) {
            finalizeCarbonAccount();
        }
        return changed;
    }

	public void finalizeCarbonAccount() {
		this.totalCarbon = CarbonTracker.computeCloudletSci(this);
	}
}

class ScarfAllocationPolicy extends VmAllocationPolicyAbstract {
	private final List<ScarfHost> allowedHosts;
	
	public ScarfAllocationPolicy(List<ScarfHost> allowedHosts) {
		this.allowedHosts = allowedHosts;
	}
	
	@Override
	protected Optional<Host> defaultFindHostForVm(Vm vm) {
		if(vm instanceof ScarfVm svm) {
			ScarfHost targetHost = svm.getTargetHost();
			if (targetHost != null && targetHost.isSuitableForVm(vm)) {
				return Optional.of(targetHost);
			}
			return Optional.empty();
		} else {
			return Optional.of(allowedHosts.stream()
					.filter(host -> host.isSuitableForVm(vm))
					.findFirst()
					.orElseThrow());
		}
	}
}

class ScarfDatacenterBroker extends DatacenterBrokerSimple {
	private final Map<String, List<ScarfVm>> routingTable = new LinkedHashMap<>();
	private final [name/] repetition;

	public ScarfDatacenterBroker(CloudSimPlus simulation, [name/] repetition) {
		super(simulation);
		this.repetition = repetition;
	}

	@Override
    protected Vm defaultVmMapper(Cloudlet cloudlet) {
        if (cloudlet instanceof ScarfCloudlet cl) {
            String tier = cl.getUser().getTier();
            List<ScarfVm> availableVms = routingTable.getOrDefault(cl.getComponent(), Collections.emptyList());
            if (availableVms.isEmpty()) Utils.log.error("Something went wrong when placing cloudlet {}", cl);
            if (cl.mandatoryExecutionLocation() != null) return cl.mandatoryExecutionLocation();

            List<ScarfVm> eligible = availableVms.stream()
                    .filter(vm -> vm.getAllowedTiers().contains(tier))
                    .filter(vm -> vm.getHost().getDatacenter() instanceof ScarfDatacenter)
                    .filter(vm -> vm.hasUserCapacity(this))
                    .collect(Collectors.toCollection(ArrayList::new));
            if (eligible.isEmpty()) return ScarfVm.NULL;

            Optional<ScarfVm> isolatedSilo = eligible.stream()
                    .filter(vm -> vm.hasPriority() && vm.getIsolationThreshold() == 1.0)
                    .findAny();
            if (isolatedSilo.isPresent()) return isolatedSilo.get();

            Map<Boolean, List<ScarfVm>> byPriority = eligible.stream()
                    .collect(Collectors.partitioningBy(ScarfVm::hasPriority));
            List<ScarfVm> silos = byPriority.get(true);
            List<ScarfVm> pools = byPriority.get(false);

            for (List<ScarfVm> group : List.of(
                    freePes(silos),
                    freePes(pools),
                    silos,
                    pools
            )) {
                if (!group.isEmpty()) return getBestByScore(group);
            }

            return ScarfVm.NULL;
        }
        return super.defaultVmMapper(cloudlet);
    }

    private List<ScarfVm> freePes(List<ScarfVm> vms) {
        return vms.stream()
                .filter(vm -> vm.getExpectedFreePesNumber() > 0)
                .collect(Collectors.toCollection(ArrayList::new));
    }

    private ScarfVm getBestByScore(List<ScarfVm> candidates) {
        if (candidates.isEmpty()) return ScarfVm.NULL;

        Collections.shuffle(candidates, Utils.rng);
        double localMaxGci = candidates.stream()
                .mapToDouble(vm -> ((ScarfDatacenter) vm.getHost().getDatacenter()).getGci())
                .filter(Double::isFinite)
                .max().orElse(0.0);
        return candidates.stream()
                .min(Comparator.comparingDouble((ScarfVm vm) -> balancedScore(vm, localMaxGci)).thenComparing(ScarfVm::getName))
                .orElse(ScarfVm.NULL);
    }

    private double balancedScore(ScarfVm vm, double maxGci) {
        double alpha = [alpha/];
        double normUtilization = vm.getCpuPercentUtilization();
        double normGci = maxGci > 0 ? ((ScarfDatacenter) vm.getHost().getDatacenter()).getGci() / maxGci : 0.0;
        return alpha * normUtilization + (1 - alpha) * normGci;
    }

	@Override
    public void processEvent(SimEvent ev) {
        if(ev.getTag() == Utils.USER_ARRIVAL_TAG) {
            double now = this.getSimulation().clock();

            User user = new User(now);
            this.repetition.addUser(user);
            this.repetition.randomUserType().process(user);

            double iat = [iatFormula(dist, p1, p2)/]
            this.scheduleNextArrival(iat);
        }
        super.processEvent(ev);
    }

    @Override
    public void startInternal() {
        super.startInternal();
        this.scheduleNextArrival(0.0);
    }

	public void registerVm(String component, ScarfVm vm) {
		routingTable.computeIfAbsent(component, _ -> new ArrayList<>()).add(vm);
	}

	private void scheduleNextArrival(double interArrivalTime) {
        if(this.getSimulation().clock() + interArrivalTime >= Utils.EXEC_TIME) return;

        this.schedule(this, interArrivalTime, Utils.USER_ARRIVAL_TAG);
    }

	public void submitCloudletAtFront(ScarfCloudlet cloudlet) {
		if (cloudlet.getSimulation().isRunning()) {
			cloudlet.setBroker(this);
			getCloudletWaitingList().addFirst(cloudlet);
		} else {
			submitCloudlet(cloudlet);
		}
	}
}

class ScarfSimulationSummary {
	@JsonProperty("interactions")
	private final Map<InteractionKey, InteractionSeries> interactions = new HashMap<>();
	@JsonProperty("devices")
	private final Map<String, HostSeries> hosts = new HashMap<>();

	public ScarfSimulationSummary(List<User> users, List<ScarfHost> hosts) {
		for(User user : users) {
			if (user.getExecutedCloudlets().isEmpty()) continue;
			Map<String, List<ScarfCloudlet>> userInteractions = user.getExecutedCloudlets().stream().collect(Collectors.groupingBy(ScarfCloudlet::getInteraction));
			for(Map.Entry<String, List<ScarfCloudlet>> interactionDetails : userInteractions.entrySet()) {
				InteractionKey key = new InteractionKey(interactionDetails.getKey(), user.getTier());
				CarbonResult totalInteractionSci = new CarbonResult(
				    interactionDetails.getValue().stream().mapToDouble(ScarfCloudlet::getTeadsSci).sum(),
				    interactionDetails.getValue().stream().mapToDouble(ScarfCloudlet::getPowerModelSci).sum(),
				    interactionDetails.getValue().stream().mapToDouble(ScarfCloudlet::getEmbodiedSci).sum()
				);
				//double duration = interactionDetails.getValue().stream().mapToDouble(Cloudlet::getFinishTime).max().orElse(0.0) - interactionDetails.getValue().stream().mapToDouble(Cloudlet::getStartTime).min().orElse(0.0);
				double duration = interactionDetails.getValue().stream().mapToDouble(Cloudlet::getTotalExecutionTime).sum();
				this.interactions.computeIfAbsent(key, _ -> new InteractionSeries()).addValue(totalInteractionSci, duration);
			}
		}
		for(ScarfHost host : hosts) {
			this.hosts.put(host.getName(), new HostSeries(host));
		}
	}

	public Map<InteractionKey, InteractionSeries> getInteractions() {
		return interactions;
	}

	public Map<String, HostSeries> getHosts() {
		return hosts;
	}
}

class ScarfGlobalSummary {
	@JsonProperty("metadata")
	Metadata metadata;
	@JsonProperty("interactions")
	private final Map<InteractionKey, List<InteractionSeries>> interactions;
	@JsonProperty("devices")
	private final Map<String, List<HostSeries>> hosts;
	
	public ScarfGlobalSummary(Metadata metadata) {
		this.metadata = metadata;
		this.interactions = new HashMap<>();
		this.hosts = new HashMap<>();
	}
	
	public void merge(ScarfSimulationSummary repetition) {
		repetition.getInteractions().forEach((key, series) ->
			this.interactions.computeIfAbsent(key, _ -> new ArrayList<>()).add(series));
		repetition.getHosts().forEach((hostName, series) ->
			this.hosts.computeIfAbsent(hostName, _ -> new ArrayList<>()).add(series));
	}
}

class User {
	private final String name;
	private final double startTime;
	private String interactionHistory;
	private final String preferredRegion;
	private final String tier;
	private final List<ScarfCloudlet> executedCloudlets = new ArrayList<>(); 
	private static final AtomicInteger userIdd = new AtomicInteger(0);
	
	public User(double st) {
		this.name = "User" + userIdd.getAndIncrement();
		this.startTime = st;
		this.interactionHistory = "";
		this.preferredRegion = Utils.REGIONS.get(Utils.rng.nextInt(Utils.REGIONS.size()));
		this.tier = Utils.TIER_MAP.ceilingEntry(Utils.rng.nextInt(Utils.TIER_MAP.lastKey() + 1)).getValue();
	}

	public String getPreferredRegion() {
		return preferredRegion;
	}

	public double getStartTime() {
		return startTime;
	}
	
	public static void resetIdCount() {
		userIdd.set(0);
	}
	
	public String getName() {
		return name;
	}

	public String getTier() {
		return tier;
	}

	public List<ScarfCloudlet> getExecutedCloudlets() {
		return executedCloudlets;
	}

	public void assignCloudlet(ScarfCloudlet cl) {
	    interactionHistory += "\n\t\t-" + cl;
		this.executedCloudlets.add(cl);
	}

	public void assignFinalCloudlet(ScarfCloudlet cl, double endTime) {
	    interactionHistory += "\n\t\t-" + cl;
		interactionHistory += "\n\t→" + cl.getInteraction() + " ['['/]" + cl.getVm() + "@" + cl.getVm().getHost() + " at time " + String.format(Locale.ENGLISH, "%.2f", (double) endTime / Utils.UNITS_OF_TIME_PER_SECOND) + " s[']'/]";
		this.executedCloudlets.add(cl);
	}
	
	@Override
	public String toString() {
		String teadsSCI = String.format(Locale.ENGLISH, "%.3e", this.executedCloudlets.stream().mapToDouble(ScarfCloudlet::getTeadsSci).sum());
		String pmSCI = String.format(Locale.ENGLISH, "%.3e", this.executedCloudlets.stream().mapToDouble(ScarfCloudlet::getPowerModelSci).sum());
		return name + " (" + tier + ") from " + preferredRegion + " at time " + String.format(Locale.ENGLISH, "%.2f", (double) startTime / Utils.UNITS_OF_TIME_PER_SECOND) + " s {TeadsSCI = " + teadsSCI + " gCO2eq, PowerModelSCI = " + pmSCI + " gC02eq}" + interactionHistory;
	}
}

class ActivityNode {
	private final TriConsumer<EventInfo, User, BiConsumer<EventInfo, User>> value;
	private final List<ActivityNode> children = new ArrayList<>();
	private final List<Integer> routingWeights = new ArrayList<>();
	private static final int DEFAULT_WEIGHT = 100;
	
	public ActivityNode(TriConsumer<EventInfo, User, BiConsumer<EventInfo, User>> value) {
		this.value = value;
	}
	
	public void addChild(ActivityNode t){
		this.children.add(t);
		this.routingWeights.add(DEFAULT_WEIGHT);
	}
	
	public void addChild(ActivityNode t, int weight) {
		this.children.add(t);
		this.routingWeights.add(weight);
	}
	
	private ActivityNode getNext() {
		if(this.children.size() == 1) {
			return this.children.getFirst();
		} else {
			int totalWeight = this.routingWeights.stream().mapToInt(Integer::intValue).sum();
			int extractedWeight = Utils.rng.nextInt(totalWeight + 1);
			int runningSum = 0;
			for(int j = 0; j < this.routingWeights.size(); j++) {
				runningSum += this.routingWeights.get(j);
				if(runningSum >= extractedWeight) return this.children.get(j);
			}
			return null;
		}
	}
	
	private BiConsumer<EventInfo, User> resolveValue() {
		if(children.isEmpty()) {
			return null;
		} else {
			ActivityNode next = getNext();
			assert next != null;
			return (evt, usr) -> next.value.accept(evt, usr, next.resolveValue());
		}
	}
	
	public void process(User user) {
		value.accept(null, user, resolveValue());
	}
	
	public void process(User user, EventInfo evt) {
		value.accept(evt, user, resolveValue());
	}
}

class CarbonTracker {
    private double lastClock = 0.0;
    private double accumulatedUtilization = 0.0;
    private double lastUtilization = 0.0;
    private final ScarfHost sourceHost;
    private final double resourceShare;
    private final List<CarbonSnapshot> carbonTimeSeries = new ArrayList<>();
    private CarbonResult totalCarbon = CarbonResult.ZERO;

    public CarbonTracker(ScarfHost source, double resShare) {
        this.resourceShare = resShare;
        this.sourceHost = source;
    }

    void updateUtilization(double clk, double utilization) {
        double delta = clk - this.lastClock;
        this.accumulatedUtilization += this.lastUtilization * delta;
        this.lastUtilization = utilization;
        this.lastClock = clk;
    }

    public CarbonResult computeSci(double clock, double interval, double currentUtilization) {
        updateUtilization(clock, currentUtilization);
        double meanIntervalUtilization = interval > 0 ? accumulatedUtilization / interval : 0.0;
        this.accumulatedUtilization = 0.0;
        CarbonResult intervalCarbon = computeSciInternal(interval, meanIntervalUtilization, this.sourceHost, this.resourceShare);
        this.carbonTimeSeries.add(new CarbonSnapshot(clock, meanIntervalUtilization, intervalCarbon));
        this.totalCarbon = this.totalCarbon.add(intervalCarbon);
        return intervalCarbon;
    }

    private static CarbonResult computeSciInternal(double interval, double meanIntervalUtilization, ScarfHost host, double resourceShare) {
        if (interval <= 0.0) return CarbonResult.ZERO;
        meanIntervalUtilization = Math.clamp(meanIntervalUtilization, 0, 1);
        double intervalSeconds = interval / Utils.UNITS_OF_TIME_PER_SECOND;
        double usedPowerTeads = host.getThermalDesignPower() * calculateTeads(meanIntervalUtilization, host.getIdlePowerFactor()) * resourceShare;
        double usedPowerPowerModel = host.getPowerModel().getPower(meanIntervalUtilization) * resourceShare;
        double deviceEnergyTeads = (intervalSeconds * usedPowerTeads) / 3600000.0;
        double deviceEnergyPowerModel = (intervalSeconds * usedPowerPowerModel) / 3600000.0;
        double energyTeads = deviceEnergyTeads + (host.getNetworkEnergy() * resourceShare);
        double energyPowerModel = deviceEnergyPowerModel + (host.getNetworkEnergy() * resourceShare);
        double gci = ((ScarfDatacenter) host.getDatacenter()).getGci();
        double carbonOperationalTeads = energyTeads * gci;
        double carbonOperationalPowerModel = energyPowerModel * gci;
        double carbonEmbodied = (host.getEmbodiedEmissions() * resourceShare) * (intervalSeconds / host.getExpectedLifespan());
        return new CarbonResult(carbonOperationalTeads + carbonEmbodied, carbonOperationalPowerModel + carbonEmbodied, carbonEmbodied);
    }

    public static CarbonResult computeCloudletSci(ScarfCloudlet cloudlet) {
        ScarfVm svm = (ScarfVm) cloudlet.getVm();
        ScarfHost sh = svm.getTargetHost();
        return computeSciInternal(cloudlet.getTotalExecutionTime(), sh.getCpuPercentUtilization(), sh, (double) cloudlet.getPesNumber() / sh.getPesNumber());
    }

    private static double calculateTeads(double utilization, double idlePowerFactor) {
        final double['[]'/] UTIL_POINTS = {0, 0.10, 0.50, 1};
        final double['[]'/] ORIGINAL_TEADS_CURVE = {0.12, 0.32, 0.75, 1.02};

        double originalIdle = ORIGINAL_TEADS_CURVE['[0]'/];
        double peak = ORIGINAL_TEADS_CURVE['[ORIGINAL_TEADS_CURVE.length - 1]'/];

        double['[]'/] TEADS_CURVE = new double['[ORIGINAL_TEADS_CURVE.length]'/];
        for (int i = 0; i < ORIGINAL_TEADS_CURVE.length; i++) {
            double normalizedPoint = (ORIGINAL_TEADS_CURVE['[i]'/] - originalIdle) / (peak - originalIdle);
            TEADS_CURVE['[i]'/] = idlePowerFactor + normalizedPoint * (peak - idlePowerFactor);
        }

        for (int i = 0; i < UTIL_POINTS.length - 1; i++) {
            ['if (utilization >= UTIL_POINTS[i] && utilization <= UTIL_POINTS[i + 1]) {'/]
                ['return TEADS_CURVE[i] + (utilization - UTIL_POINTS[i]) *'/]
                        ['(TEADS_CURVE[i + 1] - TEADS_CURVE[i]) /'/]
                        ['(UTIL_POINTS[i + 1] - UTIL_POINTS[i]);'/]
            }
        }
        ['return utilization == 0 ? TEADS_CURVE[0] : TEADS_CURVE[TEADS_CURVE.length - 1];'/]
    }

    public CarbonResult getTotalCarbon() {
        return totalCarbon;
    }

    public List<CarbonSnapshot> getCarbonTimeSeries() {
        return Collections.unmodifiableList(carbonTimeSeries);
    }
}

