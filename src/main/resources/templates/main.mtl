class Utils {
	static final int CARBON_SYNC_TAG = 123456;
	static final int USER_ARRIVAL_TAG = 654321;
	static final String REFERENCE_PERIOD = "[referencePeriod/]";
	static final OffsetTime SIMULATION_START_TIME_UTC = OffsetTime.of([startTimeHours/], [startTimeMinutes/], 0, 0, ZoneOffset.UTC);
	static final long SEED = System.currentTimeMillis();
	static Random rng = new Random(SEED);
	static Random arrivalRng = new Random(SEED);
	static Map<String, Map<String, double['[]'/]>> gciData;
	static final double UNITS_OF_TIME_PER_SECOND = 1.0; // Internal units of time are equivalent to seconds, as per default intended usage
	static final double EXEC_TIME = [durationInHours * 3600/] * UNITS_OF_TIME_PER_SECOND;
	static final int REPETITIONS = [repetitions/];
	static final List<String> REGIONS = List.of([for (r : String | UMLModel.getAppliedProfile('sciuml').eAllContents(ecore::EEnum) -> select(e | e.name = 'Region').eLiterals.name) separator(', ')]"[r/]"[/for]);
	static final NavigableMap<Integer, String> TIER_MAP = new TreeMap<>();
	static final Logger log = LoggerFactory.getLogger(Utils.class);
	
	static {
		[let tierSpecifications : Sequence(uml::Package) = UMLModel.eContents(uml::Package) -> select(p | not p.getAppliedStereotype('sciuml::TierSpecifications').oclIsUndefined())]
		[if (tierSpecifications -> size() = 0 or tierSpecifications -> size() > 1)]
		TIER_MAP.put(100, "Standard");
		[else]
		int cumulativePercentage = 0;
		[for (t : uml::Class | tierSpecifications -> any(true).eContents(uml::Class) -> select(t | not t.getAppliedStereotype('sciuml::Tier').oclIsUndefined()))]
		cumulativePercentage += [t.getValue(t.getAppliedStereotype('sciuml::Tier'), 'incidence')/];
		TIER_MAP.put(cumulativePercentage, "[t.name/]");
		[/for]
		[/if]
		[/let] [comment tierSpecifications/]

		ObjectMapper mapper = new ObjectMapper();
		try {
		    gciData = mapper.readValue(
                Utils.class.getClassLoader().getResourceAsStream("gci.json"),
                new TypeReference<>() {}
            );
            log.info("Grid Carbon Intensity values read from file!");
		} catch (Exception e) {
		    gciData = null;
		    log.warn("No Grid Carbon Intensity file provided (not even a sample one)! A constant value will be used for all Datacenters.");
		}
	}

	static double sig5(double value) {
        if (value == 0.0) return 0.0;
        return Double.parseDouble(String.format(Locale.ENGLISH, "%.4E", value));
    }
}
[/file]
[/let] [comment referenceMIPS /]
[/let] [comment ms /]
[/let] [comment packageName /]
[/let] [comment name /]
[/template]

[template public generateInteraction(cloudletStart : uml::OccurrenceSpecification, nextCloudletStart : uml::OccurrenceSpecification, availableVms : Sequence(uml::ExecutionEnvironment), rMIPS : Integer)]
[if not nextCloudletStart.oclIsUndefined()]
[let following : uml::OccurrenceSpecification = cloudletStart.followingCloudletStart()]
[following.generateInteraction(following.followingCloudletStart(), availableVms, rMIPS)/]
[/let] [comment following /]
[/if]  [comment recursion /]
[let eps : uml::Stereotype = cloudletStart.getAppliedStereotype('sciuml::TaskSpecification')]
[let end : uml::OccurrenceSpecification = cloudletStart.cloudletEnd()]
[let ends : uml::Stereotype = end.getAppliedStereotype('sciuml::TaskSpecification')]
[let component : uml::Component = cloudletStart.covered 
	-> any(true)
	.represents.eContainer(uml::Component)]
[let vm : uml::ExecutionEnvironment = availableVms -> select(ee | ee.deployment -> exists(
	d | d.deployedArtifact -> selectByKind(uml::Artifact) -> exists(
		art | art.manifestation -> exists(
			m | m.utilizedElement = component
		)
	)
)) -> any(true)]
[let device : uml::Device = vm.eContainer(uml::Device)]
[let ds : uml::Stereotype = device.getAppliedStereotype('sciuml::CarbonEmittingDevice')]
[let vs : uml::Stereotype = vm.getAppliedStereotype('sciuml::CarbonEmittingEE')]
[let cc : String = 'cl' + cloudletStart.name.safe()]
ScarfCloudlet [cc/] = new ScarfCloudlet([(end.getValue(ends, 'elapsedReferenceDemand').oclAsType(Real) * rMIPS).round()/], [end.getValue(ends, 'concurrencyFactor')/], new UtilizationModelFull(), "[cc.substring(3)/]", user, "[component.name/]", "[cloudletStart.eContainer(uml::Interaction).name.safe()/]");
[cc/].setSizes(1);
[cc/].setUtilizationModelRam(new UtilizationModelDynamic(0.0001));
[cc/].setUtilizationModelBw(new UtilizationModelDynamic(0.0001));
[if end.oclIsTypeOf(uml::ExecutionOccurrenceSpecification)]
if(next != null) {
	[cc/].addOnFinishListener(event -> {
		double clk = [cc/].getSimulation().clock();
		user.assignFinalCloudlet([cc/], clk);
		((ScarfHost) [cc/].getVm().getHost()).nudgeUtilization(clk);
		next.accept(event, user);
	});
}
[/if]  [comment ifFinal /]
[if not nextCloudletStart.oclIsUndefined()]
[let nc : String = 'cl' + nextCloudletStart.name.safe()]
[cc/].addOnFinishListener(_ -> {
	user.assignCloudlet([cc/]);
	[nc/].setPreviousCloudlet([cc/]);
	broker.submitCloudletList(List.of([nc/]), 0.01);
});
[/let] [comment nc /]
[/if]  [comment ifHasNext /]
[if cloudletStart.oclIsTypeOf(uml::ExecutionOccurrenceSpecification)]
[cc/].markAsInitial();
if (!user.getExecutedCloudlets().isEmpty())
    [cc/].setPreviousCloudlet(user.getExecutedCloudlets().getLast());
broker.submitCloudletList(List.of([cc/]), 0.01);
[/if]  [comment ifInitial /]
[/let] [comment cc /]
[/let] [comment vs /]
[/let] [comment ds /]
[/let] [comment device /]
[/let] [comment vm /]
[/let] [comment component /]
[/let] [comment ends /]
[/let] [comment end /]
[/let] [comment eps/]
[/template]

[template public iatFormula(dist : String, p1 : Real, p2 : Real)]
[if (dist = 'Exponential')](-Math.log(1 - Utils.arrivalRng.nextDouble()) / [p1/]) * Utils.UNITS_OF_TIME_PER_SECOND;
[elseif (dist = 'Uniform')]([p1/] + ([p2/] - [p1/]) * Utils.arrivalRng.nextDouble()) * Utils.UNITS_OF_TIME_PER_SECOND;
[elseif (dist = 'Constant')][p1/] * Utils.UNITS_OF_TIME_PER_SECOND;
[elseif (dist = 'Erlang')]0;
for(int i = 0; i < [p1.round()/]; i++) {
	iat += (-Math.log(1 - Utils.arrivalRng.nextDouble()) / [p2/]) * Utils.UNITS_OF_TIME_PER_SECOND;
}
[else][comment Lognormal or Log-normal /](Math.exp(Utils.arrivalRng.nextGaussian() * [p1/] + [p2/])) * Utils.UNITS_OF_TIME_PER_SECOND;
[/if]
[/template]


[query public safe(s : String) : String = s.toUpperFirst().replaceAll('[^A-Za-z0-9_]', '')/]
[query public metadataSafe(s : String) : String = s.toUpperFirst().replaceAll('[^A-Za-z0-9_-]', '')/]

[query public isStarting(os : uml::OccurrenceSpecification) : Boolean =
	let oss : uml::Stereotype = os.getAppliedStereotype('sciuml::TaskSpecification') in
	if oss.oclIsUndefined() then
		false
	else
		let exMIs : Real = os.getValue(oss, 'elapsedReferenceDemand').oclAsType(Real) in
		exMIs = 0.0
	endif
/]

[query public canBeEnd(os : uml::OccurrenceSpecification) : Boolean =
	os.oclIsTypeOf(uml::ExecutionOccurrenceSpecification)
	or
	os.eContainer(uml::Interaction).eContents(uml::Message)
	-> reject(m | m.messageSort = uml::MessageSort::asynchCall)
	-> collectNested(sendEvent)
	-> includes(os)
/]

[query public events(ll : uml::Lifeline) : OrderedSet(uml::OccurrenceSpecification) =
	ll.interaction.fragment -> selectByKind(uml::OccurrenceSpecification)-> select (os | os.covered -> includes(ll)) -> asOrderedSet()
/]

[query public cloudletEnd(o : uml::OccurrenceSpecification) : uml::OccurrenceSpecification =
	if o.isStarting() then
		let currentLifeline : uml::Lifeline = o.eContainer(uml::Interaction).eContents(uml::Lifeline) -> select(l | l.events() -> includes(o)) -> any(true) in
		if currentLifeline.oclIsUndefined() then
			null
		else
			let covereds : OrderedSet(uml::OccurrenceSpecification) = currentLifeline.events() in
			let successors : OrderedSet(uml::OccurrenceSpecification) = covereds -> subOrderedSet(covereds -> indexOf(o), covereds -> size()) -> excluding(o) -> asOrderedSet() in
			if successors -> oclIsUndefined() then
				null
			else
				successors -> select(os | os.canBeEnd()) -> first()
			endif
		endif
	else
		null
	endif	
/]

[query public followingCloudletStart(o : uml::OccurrenceSpecification) : uml::OccurrenceSpecification =
	let currentEnd : uml::OccurrenceSpecification = if o.isStarting() then o.cloudletEnd() else o endif in
	let involvedMessage : uml::Message = o.eContainer(uml::Interaction).eContents(uml::Message)
		-> select(m | m.sendEvent = currentEnd)
		-> any(true) in
	if involvedMessage.oclIsUndefined() then
		null
	else
		involvedMessage.receiveEvent.oclAsType(uml::OccurrenceSpecification)
	endif
/]

[query public getIdlePowerFactor(nodeClass : String) : Real =
    if nodeClass.startsWith('HpcServer') then
        0.2
    else
        if nodeClass.startsWith('GeneralPurposeServer') then
            0.36
        else
            0.44
        endif
    endif
/]
