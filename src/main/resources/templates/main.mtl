package [packageName/];

import java.util.*;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.function.BiConsumer;
import java.util.stream.Collectors;

import org.cloudsimplus.allocationpolicies.VmAllocationPolicyAbstract;
import org.cloudsimplus.brokers.DatacenterBrokerSimple;
import org.cloudsimplus.cloudlets.Cloudlet;
import org.cloudsimplus.cloudlets.CloudletSimple;
import org.cloudsimplus.core.CloudSimPlus;
import org.cloudsimplus.core.events.SimEvent;
import org.cloudsimplus.datacenters.DatacenterSimple;
import org.cloudsimplus.hosts.Host;
import org.cloudsimplus.hosts.HostSimple;
import org.cloudsimplus.listeners.EventInfo;
import org.cloudsimplus.power.models.PowerModelHostSimple;
import org.cloudsimplus.resources.Pe;
import org.cloudsimplus.utilizationmodels.UtilizationModel;
import org.cloudsimplus.vms.Vm;
import org.cloudsimplus.vms.VmSimple;

import com.fasterxml.jackson.annotation.JsonProperty;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/* DATA */

record CarbonResult(double teadsEstimate, double powerModelEstimate) {
	public CarbonResult add(CarbonResult other) {
		return new CarbonResult(this.teadsEstimate + other.teadsEstimate, this.powerModelEstimate + other.powerModelEstimate);
	}
}

record CarbonSnapshot(double timestamp, double utilization, CarbonResult carbonValues) {}

record InteractionKey(String interaction, String tier) {
	@Override
	public String toString() {
		return interaction() + "|" + tier();
	}
}

class InteractionSeries {
	@JsonProperty("teads_sci")
	public final List<Double> teadsSciValues = new ArrayList<>();
	@JsonProperty("power_model_sci")
	public final List<Double> powerModelSciValues = new ArrayList<>();
	@JsonProperty("service_time")
	public final List<Double> serviceTimeValues = new ArrayList<>();
	
	public void addValue(CarbonResult carbon, double time) {
		this.teadsSciValues.add(carbon.teadsEstimate());
		this.powerModelSciValues.add(carbon.powerModelEstimate());
		this.serviceTimeValues.add(time);
	}
}

class HostSeries {
	@JsonProperty("timestamps")
	private final List<Double> timestamps = new ArrayList<>();
	@JsonProperty("average_utilization")
	private final List<Double> avgUtilization = new ArrayList<>();
	@JsonProperty("average_teads_sci")
	private final List<Double> avgTeadsSci = new ArrayList<>();
	@JsonProperty("average_power_model_sci")
	private final List<Double> avgPowerModelSci = new ArrayList<>();
	
	public void addTrace(List<CarbonSnapshot> trace) {
		for(CarbonSnapshot snapshot : trace) {
			this.timestamps.add(snapshot.timestamp());
			this.avgUtilization.add(snapshot.utilization());
			this.avgTeadsSci.add(snapshot.carbonValues().teadsEstimate());
			this.avgPowerModelSci.add(snapshot.carbonValues().powerModelEstimate());
		}
	}
}

class Metadata {
	@JsonProperty("modelName")
	String expName;
	@JsonProperty("replications")
	int replications;
	@JsonProperty("duration")
	double duration;
	@JsonProperty("seed")
	long seed;
	@JsonProperty("arrivalDistributionDetails")
	String distrib;

	public Metadata(String modelName, int replications, String distrib) {
		this.expName = modelName;
		this.replications = replications;
		this.distrib = distrib;
		this.seed = Utils.SEED;
		this.duration = Utils.EXEC_TIME;
	}
}

@FunctionalInterface
interface TriConsumer<T, U, V> {
	void accept(T t, U u, V v);
}

/* SIMULATION CLASSES */

class ScarfDatacenter extends DatacenterSimple {
	private final String region;
	private final double gridCarbonIntensity;
	private double lastTimeStamp = 0.0;
	private static final double INTERVAL = Utils.UNITS_OF_TIME_PER_SECOND;  // 1 s
	private static final double DEFAULT_GRID_CARBON_INTENSITY = 300.0;

	public ScarfDatacenter(CloudSimPlus simulation, List<ScarfHost> hostList, String region) {
		super(simulation, hostList, new ScarfAllocationPolicy(hostList));
		this.region = region;
		this.gridCarbonIntensity = Utils.gciData.get(region) != null ? Utils.gciData.get(region).get("Yearly")['[0]'/] : DEFAULT_GRID_CARBON_INTENSITY;
	}
	
	@Override
	public void processEvent(SimEvent ev) {
		if(ev.getTag() == Utils.CARBON_SYNC_TAG) {
			runCarbonComputation();
		}
		super.processEvent(ev);
	}

	@Override
	protected void startInternal() {
		super.startInternal();
		this.schedule(this, INTERVAL, Utils.CARBON_SYNC_TAG);
	}

	private void runCarbonComputation() {
		double clock = getSimulation().clock();
		double duration = clock - lastTimeStamp;
		
		for (Host host : getHostList()) {
			ScarfHost sHost = (ScarfHost) host;
			sHost.processIntervalCarbon(clock, duration);
		}
		lastTimeStamp = clock;
		if (clock < Utils.EXEC_TIME) this.schedule(this, INTERVAL, Utils.CARBON_SYNC_TAG);
	}

	public String getRegion() {
		return region;
	}

	public double getGci() {
		return gridCarbonIntensity;
	}
}

class ScarfHost extends HostSimple {
	private final String name;
	private static final double NETWORK_ENERGY = 0.0; // Usually small, simplified to 0 at the moment
	private final double embodiedEmissions;
	private final double expectedLifespan;
	private final double thermalDesignPower;
	private CarbonResult totalCarbon = new CarbonResult(0.0, 0.0);
	private final List<CarbonSnapshot> carbonTimeSeries = new ArrayList<>();
	private double lastUtilClock = 0.0;
	private double accumulatedUtil = 0.0;
	private double currentUtil = 0.0;
	
	
	public ScarfHost(String name, long ram, long bw, long storage, List<Pe> peList, double embodiedEmissions, double expectedLifespan, double thermalDesignPower) {
		super(ram, bw, storage, peList);
		this.name = name;
		this.embodiedEmissions = embodiedEmissions;
		this.expectedLifespan = expectedLifespan;
		this.thermalDesignPower = thermalDesignPower;
		this.setPowerModel(new PowerModelHostSimple(thermalDesignPower, 0.2 * thermalDesignPower));
		this.enableUtilizationStats();
	}

	public void updateUtilization(double clk) {
		double timeDelta = clk - lastUtilClock;
		this.accumulatedUtil += currentUtil * timeDelta;
		this.currentUtil = this.getCpuPercentUtilization();
		this.lastUtilClock = clk;
	}

	public String getName() {
		return name;
	}

	public double getEmbodiedEmissions() {
		return embodiedEmissions;
	}
	
	public double getExpectedLifespan() {
		return expectedLifespan;
	}
	
	public double getThermalDesignPower() {
		return thermalDesignPower;
	}

	public double getNetworkEnergy() {
		return NETWORK_ENERGY;
	}
	
	public double getTeadsSci() {
		return totalCarbon.teadsEstimate();
	}
	
	public double getPowerModelSci() {
		return totalCarbon.powerModelEstimate();
	}

	public List<CarbonSnapshot> getCarbonTimeSeries() {
		return Collections.unmodifiableList(carbonTimeSeries);
	}

	public CarbonResult computeSci(double interval, double meanUtilization) {
		double intervalSeconds = interval / Utils.UNITS_OF_TIME_PER_SECOND;
		double utilization = meanUtilization == -1.0 ? this.getCpuPercentUtilization() : meanUtilization;
		double usedPowerTeads = this.thermalDesignPower * calculateTeads(utilization);
		double usedPowerPowerModel = getPowerModel().getPower(utilization);
		double deviceEnergyTeads = (intervalSeconds * usedPowerTeads) / 3600000.0;
		double deviceEnergyPowerModel = (intervalSeconds * usedPowerPowerModel) / 3600000.0;
		double energyTeads = deviceEnergyTeads + NETWORK_ENERGY;
		double energyPowerModel = deviceEnergyPowerModel + NETWORK_ENERGY;
		double gci = ((ScarfDatacenter) this.getDatacenter()).getGci();
		double carbonOperationalTeads = energyTeads * gci;
		double carbonOperationalPowerModel = energyPowerModel * gci;
		double carbonEmbodied = this.embodiedEmissions * (intervalSeconds / this.expectedLifespan);
		return new CarbonResult(carbonOperationalTeads + carbonEmbodied, carbonOperationalPowerModel + carbonEmbodied);
	}

	public void processIntervalCarbon(double clock, double interval) {
		if (interval <= 0.0) return;
		
		updateUtilization(clock);
		double meanUtilization = accumulatedUtil / interval;
		CarbonResult intervalCarbon = computeSci(interval, meanUtilization);
		this.carbonTimeSeries.add(new CarbonSnapshot(clock, meanUtilization, intervalCarbon));
		this.totalCarbon = this.totalCarbon.add(intervalCarbon);
		this.accumulatedUtil = 0.0;
	}
	
	protected static double calculateTeads(double utilization) {
		final double['[]'/] UTIL_POINTS = {0, 0.10, 0.50, 1};
		final double['[]'/] TEADS_CURVE = {0.12, 0.32, 0.75, 1.02};
		for (int i = 0; i < UTIL_POINTS.length - 1; i++) {
            ['if (utilization >= UTIL_POINTS[i] && utilization <= UTIL_POINTS[i + 1]) {'/]
                ['return TEADS_CURVE[i] + (utilization - UTIL_POINTS[i]) *'/]
                        ['(TEADS_CURVE[i + 1] - TEADS_CURVE[i]) /'/]
                        ['(UTIL_POINTS[i + 1] - UTIL_POINTS[i]);'/]
            }
        }
        ['return utilization == 0 ? TEADS_CURVE[0] : TEADS_CURVE[TEADS_CURVE.length - 1];'/]
	}

	@Override
	public String toString() {
		return name;
	}
}

class ScarfVm extends VmSimple {
	public static final ScarfVm NULL = new ScarfVm("", 0, 1, "", null, Collections.emptyList()) {
		@Override public boolean isCreated() { return false; }
		@Override public String toString() { return "ScarfVm.NULL"; }
	};
	private final String name;
	private final String component;
	private final ScarfHost targetHost;
	private final List<String> allowedTiers;
	
	public ScarfVm(String name, double mipsCapacity, long pesNumber, String component, ScarfHost targetHost, List<String> allowedTiers) {
		super(mipsCapacity, pesNumber);
		this.name = name;
		this.component = component;
		this.targetHost = targetHost;
		this.allowedTiers = allowedTiers;
		this.enableUtilizationStats();
	}

	public String getName() {
		return name;
	}

	public String getComponent() {
		return component;
	}

	public ScarfHost getTargetHost() {
		return targetHost;
	}
	
	public List<String> getAllowedTiers() {
		return allowedTiers;
	}
	
	@Override
	public String toString() {
		return name;
	}
	
}

class ScarfCloudlet extends CloudletSimple {
	private final String name;
	private User user;
	private final String component;
	private final String interaction;
	private boolean initial;
	private CarbonResult totalCarbon = new CarbonResult(0.0, 0.0);
	
	public ScarfCloudlet(long length, int pesNumber, UtilizationModel utilizationModel, String name, User user, String component, String interaction) {
		super(length, pesNumber, utilizationModel);
		this.name = name;
		this.user = user;
		this.component = component;
		this.interaction = interaction;
		this.initial = false;
	}
	
	public String getName() {
		return name;
	}

	public void markAsInitial() {
	    this.initial = true;
	}
	
	public User getUser() {
		return user;
	}

	public String getInteraction() {
		return interaction;
	}

	public String getComponent() {
		return component;
	}

	public double getTeadsSci() {
		return totalCarbon.teadsEstimate();
	}
	
	public double getPowerModelSci() {
		return totalCarbon.powerModelEstimate();
	}

	public boolean isInitial() {
        return initial;
	}

	@Override
	public String toString() {
	    return String.format(Locale.ENGLISH, "%.3f,%s,%s",
	        this.getStartTime(),
	        ((ScarfVm) getVm()).toString(),
	        this.interaction
	    );
	}

	@Override
    public boolean setStatus(final Status status) {
        boolean changed = super.setStatus(status);
        if (changed && status == Status.SUCCESS) {
            finalizeCarbonAccount();
        }
        return changed;
    }

	public void finalizeCarbonAccount() {
		ScarfHost host = (ScarfHost) getVm().getHost();
		double resourceShare = (double) getPesNumber() / host.getPesNumber();
		double interval = getTotalExecutionTime();
		CarbonResult hostCarbonResult = host.computeSci(interval, -1.0);
		this.totalCarbon = new CarbonResult(hostCarbonResult.teadsEstimate() * resourceShare, hostCarbonResult.powerModelEstimate() * resourceShare);
	}
}

class ScarfAllocationPolicy extends VmAllocationPolicyAbstract {
	private final List<ScarfHost> allowedHosts;
	
	public ScarfAllocationPolicy(List<ScarfHost> allowedHosts) {
		this.allowedHosts = allowedHosts;
	}
	
	@Override
	protected Optional<Host> defaultFindHostForVm(Vm vm) {
		if(vm instanceof ScarfVm svm) {
			ScarfHost targetHost = svm.getTargetHost();
			if (targetHost != null && targetHost.isSuitableForVm(vm)) {
				return Optional.of(targetHost);
			}
			return Optional.empty();
		} else {
			return Optional.of(allowedHosts.stream()
					.filter(host -> host.isSuitableForVm(vm))
					.findFirst()
					.orElseThrow());
		}
	}
}

class ScarfDatacenterBroker extends DatacenterBrokerSimple {
	private final Map<String, List<ScarfVm>> routingTable = new HashMap<>();
	private final [name/] repetition;

	public ScarfDatacenterBroker(CloudSimPlus simulation, [name/] repetition) {
		super(simulation);
		this.repetition = repetition;
	}

	@Override
	protected Vm defaultVmMapper(Cloudlet cloudlet) {
		if (cloudlet instanceof ScarfCloudlet cl) {
			String tier = cl.getUser().getTier();
			List<ScarfVm> candidates = routingTable.getOrDefault(cl.getComponent(), Collections.emptyList());
			if (candidates.isEmpty()) System.out.println("Something went wrong when placing cloudlet " + cl);
			return candidates.stream()
                .filter(vm -> vm.getAllowedTiers().contains(tier))
				.min(Comparator.comparingInt(vm -> vm.getAllowedTiers().size()))
                .orElse(ScarfVm.NULL);
        } 
        return super.defaultVmMapper(cloudlet);
	}

	@Override
    public void processEvent(SimEvent ev) {
        if(ev.getTag() == Utils.USER_ARRIVAL_TAG) {
            double now = this.getSimulation().clock();

            User user = new User(now);
            this.repetition.addUser(user);
            this.repetition.randomUserType().process(user);

            double iat = [iatFormula(dist, p1, p2)/]
            this.scheduleNextArrival(iat);
        }
        super.processEvent(ev);
    }

    @Override
    public void startInternal() {
        super.startInternal();
        this.scheduleNextArrival(0.0);
    }

	public void registerVm(String component, ScarfVm vm) {
		routingTable.computeIfAbsent(component, _ -> new ArrayList<>()).add(vm);
	}

	private void scheduleNextArrival(double arrivalTime) {
        if(arrivalTime >= Utils.EXEC_TIME) return;

        this.schedule(this, arrivalTime, Utils.USER_ARRIVAL_TAG);
    }

	public void submitCloudletAtFront(ScarfCloudlet cloudlet) {
		if (cloudlet.getSimulation().isRunning()) {
			cloudlet.setBroker(this);
			getCloudletWaitingList().addFirst(cloudlet);
		} else {
			submitCloudlet(cloudlet);
		}
	}
}

class ScarfSimulationSummary {
	@JsonProperty("interactions")
	private final Map<InteractionKey, InteractionSeries> interactions = new HashMap<>();
	@JsonProperty("devices")
	private final Map<String, HostSeries> hosts = new HashMap<>();

	public ScarfSimulationSummary(List<User> users, List<ScarfHost> hosts) {
		for(User user : users) {
			if (user.getExecutedCloudlets().isEmpty()) continue;
			Map<String, List<ScarfCloudlet>> userInteractions = user.getExecutedCloudlets().stream().collect(Collectors.groupingBy(ScarfCloudlet::getInteraction));
			for(Map.Entry<String, List<ScarfCloudlet>> interactionDetails : userInteractions.entrySet()) {
				InteractionKey key = new InteractionKey(interactionDetails.getKey(), user.getTier());
				CarbonResult totalInteractionSci = new CarbonResult(interactionDetails.getValue().stream().mapToDouble(ScarfCloudlet::getTeadsSci).sum(), interactionDetails.getValue().stream().mapToDouble(ScarfCloudlet::getPowerModelSci).sum());
				//double duration = interactionDetails.getValue().stream().mapToDouble(Cloudlet::getFinishTime).max().orElse(0.0) - interactionDetails.getValue().stream().mapToDouble(Cloudlet::getStartTime).min().orElse(0.0);
				double duration = interactionDetails.getValue().stream().mapToDouble(Cloudlet::getTotalExecutionTime).sum();
				this.interactions.computeIfAbsent(key, _ -> new InteractionSeries()).addValue(totalInteractionSci, duration);
			}
		}
		for(ScarfHost host : hosts) {
			this.hosts.computeIfAbsent(host.getName(), _ -> new HostSeries()).addTrace(host.getCarbonTimeSeries());
		}
	}

	public Map<InteractionKey, InteractionSeries> getInteractions() {
		return interactions;
	}

	public Map<String, HostSeries> getHosts() {
		return hosts;
	}
}

class ScarfGlobalSummary {
	@JsonProperty("metadata")
	Metadata metadata;
	@JsonProperty("interactions")
	private final Map<InteractionKey, List<InteractionSeries>> interactions;
	@JsonProperty("devices")
	private final Map<String, List<HostSeries>> hosts;
	
	public ScarfGlobalSummary(Metadata metadata) {
		this.metadata = metadata;
		this.interactions = new HashMap<>();
		this.hosts = new HashMap<>();
	}
	
	public void merge(ScarfSimulationSummary repetition) {
		repetition.getInteractions().forEach((key, series) ->
			this.interactions.computeIfAbsent(key, _ -> new ArrayList<>()).add(series));
		repetition.getHosts().forEach((hostName, series) ->
			this.hosts.computeIfAbsent(hostName, _ -> new ArrayList<>()).add(series));
	}
}

class User {
	private final String name;
	private final double startTime;
	private String interactionHistory;
	private final String preferredRegion;
	private final String tier;
	private final List<ScarfCloudlet> executedCloudlets = new ArrayList<>(); 
	private static final AtomicInteger userIdd = new AtomicInteger(0);
	
	public User(double st) {
		this.name = "User" + userIdd.getAndIncrement();
		this.startTime = st;
		this.interactionHistory = "";
		this.preferredRegion = Utils.REGIONS.get(Utils.rng.nextInt(Utils.REGIONS.size()));
		this.tier = Utils.TIER_MAP.ceilingEntry(Utils.rng.nextInt(Utils.TIER_MAP.lastKey())).getValue();
	}

	public String getPreferredRegion() {
		return preferredRegion;
	}

	public double getStartTime() {
		return startTime;
	}
	
	public static void resetIdCount() {
		userIdd.set(0);
	}
	
	public String getName() {
		return name;
	}

	public String getTier() {
		return tier;
	}

	public List<ScarfCloudlet> getExecutedCloudlets() {
		return executedCloudlets;
	}

	public void assignCloudlet(ScarfCloudlet cl) {
		this.executedCloudlets.add(cl);
	}

	public void assignFinalCloudlet(ScarfCloudlet cl, double endTime) {
		interactionHistory += "\n\t→" + cl.getInteraction() + " ['['/]" + cl.getVm() + "@" + cl.getVm().getHost() + " at time " + String.format(Locale.ENGLISH, "%.2f", endTime) + " s[']'/]";
		this.executedCloudlets.add(cl);
	}
	
	@Override
	public String toString() {
		String teadsSCI = String.format(Locale.ENGLISH, "%.3e", this.executedCloudlets.stream().mapToDouble(ScarfCloudlet::getTeadsSci).sum());
		String pmSCI = String.format(Locale.ENGLISH, "%.3e", this.executedCloudlets.stream().mapToDouble(ScarfCloudlet::getPowerModelSci).sum());
		return name + " (" + tier + ") from " + preferredRegion + " at time " + String.format(Locale.ENGLISH, "%.2f", startTime) + " s {TeadsSCI = " + teadsSCI + " gCO2eq, PowerModelSCI = " + pmSCI + " gC02eq}" + interactionHistory;
	}
}

class ActivityNode {
	private final TriConsumer<EventInfo, User, BiConsumer<EventInfo, User>> value;
	private final List<ActivityNode> children = new ArrayList<>();
	private final List<Integer> routingWeights = new ArrayList<>();
	private static final int DEFAULT_WEIGHT = 100;
	
	public ActivityNode(TriConsumer<EventInfo, User, BiConsumer<EventInfo, User>> value) {
		this.value = value;
	}
	
	public void addChild(ActivityNode t){
		this.children.add(t);
		this.routingWeights.add(DEFAULT_WEIGHT);
	}
	
	public void addChild(ActivityNode t, int weight) {
		this.children.add(t);
		this.routingWeights.add(weight);
	}
	
	private ActivityNode getNext() {
		if(this.children.size() == 1) {
			return this.children.getFirst();
		} else {
			int totalWeight = this.routingWeights.stream().mapToInt(Integer::intValue).sum();
			int extractedWeight = Utils.rng.nextInt(totalWeight + 1);
			int runningSum = 0;
			for(int j = 0; j < this.routingWeights.size(); j++) {
				runningSum += this.routingWeights.get(j);
				if(runningSum >= extractedWeight) return this.children.get(j);
			}
			return null;
		}
	}
	
	private BiConsumer<EventInfo, User> resolveValue() {
		if(children.isEmpty()) {
			return null;
		} else {
			ActivityNode next = getNext();
			assert next != null;
			return (evt, usr) -> next.value.accept(evt, usr, next.resolveValue());
		}
	}
	
	public void process(User user) {
		value.accept(null, user, resolveValue());
	}
	
	public void process(User user, EventInfo evt) {
		value.accept(evt, user, resolveValue());
	}
}

