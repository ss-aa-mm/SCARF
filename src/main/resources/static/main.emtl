            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;&#x9;&#x9;&#x9;tt += iat;&#xA;&#x9;&#x9;}&#xA;&#xA;&#x9;&#x9;simulation.addOnClockTickListener(this::checkArrivals);&#xA;&#x9;&#x9;simulation.terminateAt(Utils.EXEC_TIME);&#xA;&#x9;&#x9;simulation.start();&#xA;&#xA;&#x9;&#x9;System.out.println(&quot;Finished Simulation Repetition #&quot; + rep);&#xA;&#x9;&#x9;System.out.println(&quot;Executed Cloudlets: &quot; + cloudletList.size());&#xA;&#x9;&#x9;System.out.println(&quot;Total Cloudlets Teads SCI: &quot; + cloudletList.stream().mapToDouble(ScarfCloudlet::getTeadsSci).sum());&#xA;&#x9;&#x9;System.out.println(&quot;Total Cloudlets PowerModel SCI: &quot; + cloudletList.stream().mapToDouble(ScarfCloudlet::getPowerModelSci).sum());&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;try {&#xA;&#x9;&#x9;&#x9;Files.write(Path.of(basePath, &quot;"/>
            <body xsi:type="ocl.ecore:VariableExp" name="packageName" referredVariable="/0/projectGenerator/%/%/packageName">
