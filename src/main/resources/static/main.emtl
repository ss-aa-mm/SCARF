            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&quot;;&#xA;&#x9;&#x9;exp.metadata.replications = Utils.REPETITIONS;&#xA;&#x9;&#x9;exp.metadata.duration = Utils.EXEC_TIME;&#xA;&#x9;&#x9;exp.metadata.seed = Utils.SEED;&#xA;&#xA;&#x9;&#x9;for (SimulationResult run : simResults) {&#xA;&#x9;&#x9;&#x9;for (SimulationResult.InteractionResult ir : run.interactionResults) {&#xA;&#x9;&#x9;&#x9;&#x9;Map&lt;String, Object> record = new LinkedHashMap&lt;>();&#xA;&#x9;&#x9;&#x9;&#x9;record.put(&quot;simulationRun&quot;, runIndex);&#xA;&#x9;&#x9;&#x9;&#x9;record.put(&quot;name&quot;, ir.interactionName);&#xA;&#x9;&#x9;&#x9;&#x9;record.put(&quot;SCI&quot;, ir.avgSCI);&#xA;&#x9;&#x9;&#x9;&#x9;record.put(&quot;ServiceTime&quot;, ir.avgServiceTime);&#xA;&#x9;&#x9;&#x9;&#x9;record.put(&quot;Throughput&quot;, ir.throughput);&#xA;&#x9;&#x9;&#x9;&#x9;exp.interactions.add(record);&#xA;&#x9;&#x9;&#x9;}&#xA;&#xA;&#x9;&#x9;&#x9;for (SimulationResult.DeviceResult dr : run.deviceResults) {&#xA;&#x9;&#x9;&#x9;&#x9;Map&lt;String, Object> record = new LinkedHashMap&lt;>();&#xA;                record.put(&quot;run&quot;, runIndex);&#xA;                record.put(&quot;name&quot;, dr.deviceName);&#xA;                record.put(&quot;SCI&quot;, dr.avgSCI);&#xA;                record.put(&quot;ServiceTime&quot;, dr.avgServiceTime);&#xA;                record.put(&quot;Throughput&quot;, dr.throughput);&#xA;                record.put(&quot;Utilization&quot;, dr.avgUtilization);&#xA;                record.put(&quot;DroppedConnections&quot;, dr.droppedConnections);&#xA;                exp.servers.add(record);&#xA;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;runIndex++;&#xA;&#x9;&#x9;}&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;try {&#xA;&#x9;&#x9;&#x9;int cnt = 1;&#xA;&#x9;&#x9;&#x9;for (ArrayList&lt;User> repResults : userConnections) {&#xA;&#x9;&#x9;&#x9;&#x9;Files.write(Path.of(basePath, &quot;"/>
