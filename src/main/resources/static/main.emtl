            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol=";&#xA;&#xA;import java.util.*;&#xA;import java.util.concurrent.atomic.AtomicInteger;&#xA;import java.util.function.BiConsumer;&#xA;import java.util.function.Function;&#xA;import java.util.stream.Collectors;&#xA;&#xA;import javax.xml.stream.XMLInputFactory;&#xA;import javax.xml.stream.XMLStreamConstants;&#xA;import javax.xml.stream.XMLStreamReader;&#xA;&#xA;import org.cloudsimplus.allocationpolicies.VmAllocationPolicyAbstract;&#xA;import org.cloudsimplus.brokers.DatacenterBrokerSimple;&#xA;import org.cloudsimplus.builders.tables.MarkdownTable;&#xA;import org.cloudsimplus.builders.tables.TableBuilderAbstract;&#xA;import org.cloudsimplus.cloudlets.Cloudlet;&#xA;import org.cloudsimplus.cloudlets.CloudletExecution;&#xA;import org.cloudsimplus.cloudlets.Cloudlet.Status;&#xA;import org.cloudsimplus.cloudlets.CloudletSimple;&#xA;import org.cloudsimplus.core.CloudSimPlus;&#xA;import org.cloudsimplus.core.events.SimEvent;&#xA;import org.cloudsimplus.datacenters.DatacenterSimple;&#xA;import org.cloudsimplus.hosts.Host;&#xA;import org.cloudsimplus.hosts.HostSimple;&#xA;import org.cloudsimplus.listeners.EventInfo;&#xA;import org.cloudsimplus.resources.Pe;&#xA;import org.cloudsimplus.utilizationmodels.UtilizationModel;&#xA;import org.cloudsimplus.vms.Vm;&#xA;import org.cloudsimplus.vms.VmSimple;&#xA;&#xA;import com.fasterxml.jackson.annotation.JsonProperty;&#xA;&#xA;record CarbonResult(double teadsEstimate, double powerModelEstimate) {&#xA;&#x9;public CarbonResult add(CarbonResult other) {&#xA;&#x9;&#x9;return new CarbonResult(this.teadsEstimate + other.teadsEstimate, this.powerModelEstimate + other.powerModelEstimate);&#xA;&#x9;}&#xA;}&#xA;record CarbonSnapshot(double timestamp, CarbonResult carbonValues) {}&#xA;&#xA;class ScarfDatacenter extends DatacenterSimple {&#xA;&#x9;private final String region;&#xA;&#x9;private int gridCarbonIntensity;&#xA;&#x9;private double lastTimeStamp = 0.0;&#xA;&#x9;private static final double INTERVAL = 10.0;&#xA;&#x9;private static final int DEFAULT_GRID_CARBON_INTENSITY = 300;&#xA;&#xA;&#x9;public ScarfDatacenter(CloudSimPlus simulation, List&lt;ScarfHost> hostList, String region) {&#xA;&#x9;&#x9;super(simulation, hostList, new ScarfAllocationPolicy(hostList));&#xA;&#x9;&#x9;this.region = region;&#xA;&#x9;&#x9;this.gridCarbonIntensity = Utils.gcis.get(region) != null ? Utils.gcis.get(region) : DEFAULT_GRID_CARBON_INTENSITY;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;@Override&#xA;&#x9;public void processEvent(SimEvent ev) {&#xA;&#x9;&#x9;if(ev.getTag() == Utils.CARBON_SYNC_TAG) {&#xA;&#x9;&#x9;&#x9;runCarbonComputation();&#xA;&#x9;&#x9;}&#xA;&#x9;&#x9;super.processEvent(ev);&#xA;&#x9;}&#xA;&#xA;&#x9;@Override&#xA;&#x9;protected void startInternal() {&#xA;&#x9;&#x9;super.startInternal();&#xA;&#x9;&#x9;this.schedule(this, INTERVAL, Utils.CARBON_SYNC_TAG);&#xA;&#x9;}&#xA;&#xA;&#x9;private void runCarbonComputation() {&#xA;&#x9;&#x9;double clock = getSimulation().clock();&#xA;&#x9;&#x9;double duration = clock - lastTimeStamp;&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;for (Host host : getHostList()) {&#xA;&#x9;&#x9;&#x9;ScarfHost sHost = (ScarfHost) host;&#xA;&#x9;&#x9;&#x9;sHost.processIntervalCarbon(clock, duration);&#xA;&#x9;&#x9;}&#xA;&#x9;&#x9;lastTimeStamp = clock;&#xA;&#x9;&#x9;if (clock &lt; Utils.EXEC_TIME) this.schedule(this, INTERVAL, Utils.CARBON_SYNC_TAG);&#xA;&#x9;}&#xA;&#xA;&#x9;public String getRegion() {&#xA;&#x9;&#x9;return region;&#xA;&#x9;}&#xA;&#xA;&#x9;public int getGci() {&#xA;&#x9;&#x9;return gridCarbonIntensity;&#xA;&#x9;}&#xA;}&#xA;&#xA;class ScarfHost extends HostSimple {&#xA;&#x9;private String name;&#xA;&#x9;private static final double NETWORK_ENERGY = 0.0; // Usually small, simplified to 0 at the moment&#xA;&#x9;private double embodiedEmissions;&#xA;&#x9;private double expectedLifespan;&#xA;&#x9;private double thermalDesignPower;&#xA;&#x9;private CarbonResult totalCarbon = new CarbonResult(0.0, 0.0);&#xA;&#x9;private final List&lt;CarbonSnapshot> carbonTimeSeries = new ArrayList&lt;>();&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;public ScarfHost(String name, long ram, long bw, long storage, List&lt;Pe> peList, double embodiedEmissions, double expectedLifespan, double thermalDesignPower) {&#xA;&#x9;&#x9;super(ram, bw, storage, peList);&#xA;&#x9;&#x9;this.name = name;&#xA;&#x9;&#x9;this.embodiedEmissions = embodiedEmissions;&#xA;&#x9;&#x9;this.expectedLifespan = expectedLifespan;&#xA;&#x9;&#x9;this.thermalDesignPower = thermalDesignPower;&#xA;&#x9;&#x9;this.enableUtilizationStats();&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public double getSciLegacy() {&#xA;&#x9;&#x9;ScarfDatacenter dc = (ScarfDatacenter) this.getDatacenter();&#xA;&#x9;&#x9;double timeInterval = this.getTotalExecutionTime();&#xA;&#x9;&#x9;double usedPower = this.thermalDesignPower * calculateTeads(this.myUtil());&#xA;&#x9;&#x9;double resourceShare = (double) this.getVmCreatedList().stream().mapToLong(obj -> obj.getPesNumber()).sum() / this.getPesNumber();&#xA;&#x9;&#x9;double deviceEnergy = (timeInterval * usedPower) / 3600000; // This already considers the resource share&#xA;&#x9;&#x9;double energy = deviceEnergy + NETWORK_ENERGY;&#xA;&#x9;&#x9;double carbonOperational = dc.getGci() * energy;&#xA;&#x9;&#x9;double embodiedCarbon = this.embodiedEmissions * (timeInterval / this.expectedLifespan) * resourceShare;&#xA;&#x9;&#x9;return carbonOperational + embodiedCarbon;&#xA;&#x9;}&#xA;&#xA;&#x9;public Double myUtil() {&#xA;&#x9;&#x9;return this.getVmCreatedList().stream().mapToDouble(obj -> obj.getPesNumber() * obj.getCpuUtilizationStats().getMean()).sum() / this.getPesNumber();&#xA;&#x9;}&#xA;&#xA;&#x9;public String getName() {&#xA;&#x9;&#x9;return name;&#xA;&#x9;}&#xA;&#xA;&#x9;public double getEmbodiedEmissions() {&#xA;&#x9;&#x9;return embodiedEmissions;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public double getExpectedLifespan() {&#xA;&#x9;&#x9;return expectedLifespan;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public double getThermalDesignPower() {&#xA;&#x9;&#x9;return thermalDesignPower;&#xA;&#x9;}&#xA;&#xA;&#x9;public double getNetworkEnergy() {&#xA;&#x9;&#x9;return NETWORK_ENERGY;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public double getTeadsSci() {&#xA;&#x9;&#x9;return totalCarbon.teadsEstimate();&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public double getPowerModelSci() {&#xA;&#x9;&#x9;return totalCarbon.powerModelEstimate();&#xA;&#x9;}&#xA;&#xA;&#x9;public List&lt;CarbonSnapshot> getCarbonTimeSeries() {&#xA;&#x9;&#x9;return Collections.unmodifiableList(carbonTimeSeries);&#xA;&#x9;}&#xA;&#xA;&#x9;public CarbonResult computeSci(double interval) {&#xA;&#x9;&#x9;double usedPowerTeads = this.thermalDesignPower * calculateTeads(myUtil());&#xA;&#x9;&#x9;double usedPowerPowerModel = getPowerModel().getPower(myUtil());&#xA;&#x9;&#x9;double deviceEnergyTeads = (interval * usedPowerTeads) / 3600000.0;&#xA;&#x9;&#x9;double deviceEnergyPowerModel = (interval * usedPowerPowerModel) / 3600000.0;&#xA;&#x9;&#x9;double energyTeads = deviceEnergyTeads + NETWORK_ENERGY;&#xA;&#x9;&#x9;double energyPowerModel = deviceEnergyPowerModel + NETWORK_ENERGY;&#xA;&#x9;&#x9;double gci = ((ScarfDatacenter) this.getDatacenter()).getGci();&#xA;&#x9;&#x9;double carbonOperationalTeads = energyTeads * gci;&#xA;&#x9;&#x9;double carbonOperationalPowerModel = energyPowerModel * gci;&#xA;&#x9;&#x9;double carbonEmbodied = this.embodiedEmissions * (interval / this.expectedLifespan);&#xA;&#x9;&#x9;return new CarbonResult(carbonOperationalTeads + carbonEmbodied, carbonOperationalPowerModel + carbonEmbodied);&#xA;&#x9;}&#xA;&#xA;&#x9;public void processIntervalCarbon(double clock, double interval) {&#xA;&#x9;&#x9;if (interval &lt;= 0.0) return;&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;CarbonResult intervalCarbon = computeSci(interval);&#xA;&#x9;&#x9;this.carbonTimeSeries.add(new CarbonSnapshot(clock, intervalCarbon));&#xA;&#x9;&#x9;this.totalCarbon = this.totalCarbon.add(intervalCarbon);&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;protected static double calculateTeads(double utilization) {&#xA;&#x9;&#x9;final double"/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="[]">
              <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/String"/>
            </body>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol=" UTIL_POINTS = {0, 0.10, 0.50, 1};&#xA;&#x9;&#x9;final double"/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="[]">
              <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/String"/>
            </body>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol=" TEADS_CURVE = {0.12, 0.32, 0.75, 1.02};&#xA;&#x9;&#x9;for (int i = 0; i &lt; UTIL_POINTS.length - 1; i++) {&#xA;            "/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="if (utilization >= UTIL_POINTS[i] &amp;&amp; utilization &lt;= UTIL_POINTS[i + 1]) {">
              <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/String"/>
            </body>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;                "/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="return TEADS_CURVE[i] + (utilization - UTIL_POINTS[i]) *">
              <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/String"/>
            </body>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;                        "/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="(TEADS_CURVE[i + 1] - TEADS_CURVE[i]) /">
              <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/String"/>
            </body>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;                        "/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="(UTIL_POINTS[i + 1] - UTIL_POINTS[i]);">
              <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/String"/>
            </body>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;            }&#xA;        }&#xA;        "/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="return utilization == 0 ? TEADS_CURVE[0] : TEADS_CURVE[TEADS_CURVE.length - 1];">
              <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/String"/>
            </body>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;&#x9;}&#xA;&#xA;&#x9;@Override&#xA;&#x9;public String toString() {&#xA;&#x9;&#x9;return name;&#xA;&#x9;}&#xA;}&#xA;&#xA;class ScarfVm extends VmSimple {&#xA;&#x9;public static final ScarfVm NULL = new ScarfVm(&quot;&quot;, 0, 1, &quot;&quot;, null) {&#xA;&#x9;&#x9;@Override public boolean isCreated() { return false; }&#xA;&#x9;&#x9;@Override public String toString() { return &quot;ScarfVm.NULL&quot;; }&#xA;&#x9;};&#xA;&#x9;private String name;&#xA;&#x9;private String component;&#xA;&#x9;private ScarfHost targetHost;&#xA;&#x9;&#xA;&#x9;public ScarfVm(String name, double mipsCapacity, long pesNumber, String component, ScarfHost targetHost) {&#xA;&#x9;&#x9;super(mipsCapacity, pesNumber);&#xA;&#x9;&#x9;this.name = name;&#xA;&#x9;&#x9;this.component = component;&#xA;&#x9;&#x9;this.targetHost = targetHost;&#xA;&#x9;&#x9;this.enableUtilizationStats();&#xA;&#x9;}&#xA;&#xA;&#x9;public String getName() {&#xA;&#x9;&#x9;return name;&#xA;&#x9;}&#xA;&#xA;&#x9;public String getComponent() {&#xA;&#x9;&#x9;return component;&#xA;&#x9;}&#xA;&#xA;&#x9;public ScarfHost getTargetHost() {&#xA;&#x9;&#x9;return targetHost;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;@Override&#xA;&#x9;public String toString() {&#xA;&#x9;&#x9;return name;&#xA;&#x9;}&#xA;&#x9;&#xA;}&#xA;&#xA;class ScarfCloudlet extends CloudletSimple {&#xA;&#x9;private String name;&#xA;&#x9;private User user;&#xA;&#x9;private String component;&#xA;&#x9;private String interaction;&#xA;&#x9;private CarbonResult totalCarbon = new CarbonResult(0.0, 0.0);&#xA;&#x9;&#xA;&#x9;public ScarfCloudlet(long length, int pesNumber, UtilizationModel utilizationModel, String name, User user, String component, String interaction) {&#xA;&#x9;&#x9;super(length, pesNumber, utilizationModel);&#xA;&#x9;&#x9;this.name = name;&#xA;&#x9;&#x9;this.user = user;&#xA;&#x9;&#x9;this.component = component;&#xA;&#x9;&#x9;this.interaction = interaction;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public String getName() {&#xA;&#x9;&#x9;return name;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public User getUser() {&#xA;&#x9;&#x9;return user;&#xA;&#x9;}&#xA;&#xA;&#x9;public String getInteraction() {&#xA;&#x9;&#x9;return interaction;&#xA;&#x9;}&#xA;&#xA;&#x9;public String getComponent() {&#xA;&#x9;&#x9;return component;&#xA;&#x9;}&#xA;&#xA;&#x9;public double getTeadsSci() {&#xA;&#x9;&#x9;return totalCarbon.teadsEstimate();&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public double getPowerModelSci() {&#xA;&#x9;&#x9;return totalCarbon.powerModelEstimate();&#xA;&#x9;}&#xA;&#xA;&#x9;@Override&#xA;    public boolean setStatus(final Status status) {&#xA;        boolean changed = super.setStatus(status);&#xA;        if (changed &amp;&amp; status == Status.SUCCESS) {&#xA;            finalizeCarbonAccount();&#xA;        }&#xA;        return changed;&#xA;    }&#xA;&#xA;&#x9;public void finalizeCarbonAccount() {&#xA;&#x9;&#x9;ScarfHost host = (ScarfHost) getVm().getHost();&#xA;&#x9;&#x9;double resourceShare = (double) getPesNumber() / host.getPesNumber();&#xA;&#x9;&#x9;double interval = getTotalExecutionTime();&#xA;&#x9;&#x9;CarbonResult hostCarbonResult = host.computeSci(interval);&#xA;&#x9;&#x9;this.totalCarbon = new CarbonResult(hostCarbonResult.teadsEstimate() * resourceShare, hostCarbonResult.powerModelEstimate() * resourceShare);;&#xA;&#x9;}&#xA;}&#xA;&#xA;class ScarfAllocationPolicy extends VmAllocationPolicyAbstract {&#xA;&#x9;private final List&lt;ScarfHost> allowedHosts;&#xA;&#x9;private final boolean hostsAreNamed;&#xA;&#x9;&#xA;&#x9;public ScarfAllocationPolicy(List&lt;ScarfHost> allowedHosts) {&#xA;&#x9;&#x9;this.allowedHosts = allowedHosts;&#xA;&#x9;&#x9;this.hostsAreNamed = allowedHosts.stream().allMatch(host -> ScarfHost.class.isInstance(host));&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;@Override&#xA;&#x9;protected Optional&lt;Host> defaultFindHostForVm(Vm vm) {&#xA;&#x9;&#x9;if(vm instanceof ScarfVm &amp;&amp; hostsAreNamed) {&#xA;&#x9;&#x9;&#x9;ScarfHost targetHost = ((ScarfVm) vm).getTargetHost();&#xA;&#x9;&#x9;&#x9;if (targetHost != null &amp;&amp; targetHost.isSuitableForVm(vm)) {&#xA;&#x9;&#x9;&#x9;&#x9;return Optional.of(targetHost);&#xA;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;return Optional.empty();&#xA;&#x9;&#x9;} else {&#xA;&#x9;&#x9;&#x9;return Optional.of(allowedHosts.stream()&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;.filter(host -> host.isSuitableForVm(vm))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;.findFirst()&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;.orElseThrow());&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;}&#xA;&#xA;class ScarfDatacenterBroker extends DatacenterBrokerSimple {&#xA;&#x9;private final Map&lt;String, List&lt;ScarfVm>> routingTable = new HashMap&lt;>();&#xA;&#xA;&#x9;public ScarfDatacenterBroker(CloudSimPlus simulation) {&#xA;&#x9;&#x9;super(simulation);&#xA;&#x9;}&#xA;&#xA;&#x9;@Override&#xA;&#x9;protected Vm defaultVmMapper(Cloudlet cloudlet) {&#xA;&#x9;&#x9;if (cloudlet instanceof ScarfCloudlet cl) {&#xA;&#x9;&#x9;&#x9;List&lt;ScarfVm> candidates = routingTable.getOrDefault(cl.getComponent(), Collections.emptyList());&#xA;&#x9;&#x9;&#x9;if (candidates.isEmpty()) System.out.println(&quot;Something went wrong when placing cloudlet &quot; + cl);&#xA;&#x9;&#x9;&#x9;return candidates.stream()&#xA;                //.filter(Vm::isCreated)&#xA;                .findAny()&#xA;                .orElse(ScarfVm.NULL);&#xA;        } &#xA;        return super.defaultVmMapper(cloudlet);&#xA;&#x9;}&#xA;&#xA;&#x9;public void registerVm(String component, ScarfVm vm) {&#xA;&#x9;&#x9;routingTable.computeIfAbsent(component, k -> new ArrayList&lt;>()).add(vm);&#xA;&#x9;}&#xA;}&#xA;&#xA;/*class CustomTableBuilder extends TableBuilderAbstract&lt;ScarfCloudlet> {&#xA;&#x9;&#xA;&#x9;private final List&lt;? extends ScarfCloudlet> list;&#xA;&#x9;&#xA;&#x9;public CustomTableBuilder(List&lt;? extends ScarfCloudlet> list, double t) {&#xA;&#x9;&#x9;super(list, new MarkdownTable().setTitle(&quot;SIMULATION RESULTS (Run for &quot; + String.format(&quot;%.2f&quot; ,t) + &quot; seconds)&quot;));&#xA;&#x9;&#x9;list.sort(Comparator.comparingDouble(ScarfCloudlet::getStartTime));&#xA;&#x9;&#x9;this.list = list;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;@Override&#xA;    protected void createTableColumns() {&#xA;&#x9;&#x9;newColumn(&quot;User&quot;, &quot;Name&quot;, obj -> obj.getUser().getName());&#xA;&#x9;&#x9;newColumn(&quot;Interaction&quot;, &quot;Name&quot;, ScarfCloudlet::getInteraction);&#xA;&#x9;&#x9;newColumn(&quot;Cloudlet&quot;, &quot;Name&quot;, ScarfCloudlet::getName);&#xA;&#x9;&#x9;newColumn(&quot;Status&quot;, &quot;&quot;, obj -> obj.getStatus().name());&#xA;&#x9;&#x9;newColumn(&quot;Datacenter&quot;, &quot;Name&quot;, obj -> obj.getVm().getHost().getDatacenter().getName());&#xA;        newColumn(&quot;Host&quot;, &quot;Name&quot;, cloudlet -> ((ScarfHost) cloudlet.getVm().getHost()).getName());&#xA;        newColumn(&quot;Host PEs&quot;, &quot;CPU cores&quot;, cloudlet -> cloudlet.getVm().getHost().getWorkingPesNumber());&#xA;        newColumn(&quot;VM&quot;, &quot;Name&quot;, cloudlet -> cloudlet.getVm().getDescription());&#xA;        newColumn(&quot;VM PEs&quot;, &quot;CPU cores&quot;, cloudlet -> cloudlet.getVm().getPesNumber());&#xA;        newColumn(&quot;CloudletLen&quot;, &quot;MI&quot;, Cloudlet::getLength);&#xA;        newColumn(&quot;FinishedLen&quot;, &quot;MI&quot;, Cloudlet::getFinishedLengthSoFar);&#xA;        newColumn(&quot;CloudletPEs&quot;, &quot;CPU cores&quot;, Cloudlet::getPesNumber);&#xA;        newColumn(&quot;StartTime&quot;, &quot;Seconds&quot;, cloudlet -> String.format(&quot;%.1f&quot;, cloudlet.getStartTime()));&#xA;        newColumn(&quot;FinishTime&quot;, &quot;Seconds&quot;, cloudlet -> String.format(&quot;%.1f&quot;, cloudlet.getFinishTime()));&#xA;        newColumn(&quot;ExecTime&quot;, &quot;Seconds&quot;, cloudlet -> String.format(&quot;%.1f&quot;, cloudlet.getTotalExecutionTime()));&#xA;&#x9;&#x9;newColumn(&quot;SCI&quot;, &quot;gCO2eq&quot;, cloudlet -> String.format(&quot;%.4f&quot;, cloudlet.getSci()));&#xA;    }&#xA;&#x9;&#xA;&#x9;private void newColumn(String title, String subtitle, Function&lt;ScarfCloudlet, Object> f) {&#xA;&#x9;&#x9;String fm = &quot;%&quot; + Math.max(this.list.stream().map(obj -> f.apply(obj).toString()).mapToInt(String::length).max().orElse(title.length()), Math.max(title.length(), subtitle.length())) + &quot;s&quot;;&#xA;&#x9;&#x9;addColumn(getTable().newColumn(String.format(fm, title), subtitle, fm), f);&#xA;&#x9;}&#xA;}*/&#xA;&#xA;/*class VmTableBuilder extends TableBuilderAbstract&lt;Vm> {&#xA;&#x9;&#xA;&#x9;private final List&lt;? extends Vm> list;&#xA;&#x9;&#xA;&#x9;public VmTableBuilder(List&lt;? extends Vm> list) {&#xA;&#x9;&#x9;super(list, new MarkdownTable().setTitle(&quot;Hosts and VMs Statistics&quot;));&#xA;&#x9;&#x9;list.sort(Comparator.comparing(obj -> ((ScarfHost) obj.getHost()).getName()));&#xA;&#x9;&#x9;this.list = list;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;@Override&#xA;    protected void createTableColumns() {&#xA;&#x9;&#x9;newColumn(&quot;Host&quot;, &quot;Name&quot;, obj -> ((ScarfHost) obj.getHost()).getName());&#xA;&#x9;&#x9;newColumn(&quot;Host SCI&quot;, &quot;gCO2eq&quot;, obj -> String.format(&quot;%.4f&quot;, ((ScarfHost) obj.getHost()).getSci()));&#xA;&#x9;&#x9;newColumn(&quot;Host CPU Utilization&quot;, &quot;Mean&quot;, obj -> String.format(&quot;%.2f%%&quot;, ((ScarfHost) obj.getHost()).myUtil() * 100));&#xA;&#x9;&#x9;newColumn(&quot;VM&quot;, &quot;Name&quot;, Vm::getDescription);&#xA;&#x9;&#x9;newColumn(&quot;VM CPU Utilization&quot;, &quot;Mean&quot;, obj -> String.format(&quot;%.2f%%&quot;, obj.getCpuUtilizationStats().getMean() * 100));&#xA;    }&#xA;&#x9;&#xA;&#x9;private void newColumn(String title, String subtitle, Function&lt;Vm, Object> f) {&#xA;&#x9;&#x9;String fm = &quot;%&quot; + Math.max(this.list.stream().map(obj -> f.apply(obj).toString()).mapToInt(String::length).max().orElse(title.length()), Math.max(title.length(), subtitle.length())) + &quot;s&quot;;&#xA;&#x9;&#x9;addColumn(getTable().newColumn(String.format(fm, title), subtitle, fm), f);&#xA;&#x9;}&#xA;}*/&#xA;&#xA;class User {&#xA;&#x9;private final String name;&#xA;&#x9;private final double startTime;&#xA;&#x9;private String interactionHistory;&#xA;&#x9;private final String preferredRegion;&#xA;&#x9;private final String tier;&#xA;&#x9;private static final AtomicInteger userIdd = new AtomicInteger(0);&#xA;&#x9;&#xA;&#x9;public User(double st) {&#xA;&#x9;&#x9;this.name = &quot;User&quot; + userIdd.getAndIncrement();&#xA;&#x9;&#x9;this.startTime = st;&#xA;&#x9;&#x9;this.interactionHistory = &quot;&quot;;&#xA;&#x9;&#x9;this.preferredRegion = Utils.REGIONS.get(Utils.rng.nextInt(Utils.REGIONS.size()));&#xA;&#x9;&#x9;this.tier = Utils.TIERS.get(Utils.rng.nextInt(Utils.TIERS.size()));&#xA;&#x9;}&#xA;&#xA;&#x9;public String getPreferredRegion() {&#xA;&#x9;&#x9;return preferredRegion;&#xA;&#x9;}&#xA;&#xA;&#x9;public double getStartTime() {&#xA;&#x9;&#x9;return startTime;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public static void resetIdCount() {&#xA;&#x9;&#x9;userIdd.set(0);&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public String getName() {&#xA;&#x9;&#x9;return name;&#xA;&#x9;}&#xA;&#xA;&#x9;public String getTier() {&#xA;&#x9;&#x9;return tier;&#xA;&#x9;}&#xA;&#xA;&#x9;public void updateHistory(String nodeName, String vmName, String hostName, double endTime) {&#xA;&#x9;&#x9;interactionHistory += &quot;\n\t\u2192&quot; + nodeName + &quot; "/>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="[">
              <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/String"/>
            </body>
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&quot; + vmName + &quot;@&quot; + hostName + &quot; at time &quot; + endTime + &quot;"/>
