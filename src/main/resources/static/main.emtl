            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="_&quot; + rep + &quot;.txt&quot;), currentRepUsers.stream().map(Object::toString).toList(), StandardCharsets.UTF_8);&#xA;&#x9;&#x9;} catch (IOException e) {&#xA;&#x9;&#x9;&#x9;log.error(e.getMessage());&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;&#xA;&#x9;public void checkArrivals(EventInfo evt) {&#xA;&#x9;&#x9;if(!users.isEmpty() &amp;&amp; users.peek().getStartTime() &lt;= evt.getTime()) {&#xA;&#x9;&#x9;&#x9;User user = users.pop();&#xA;&#x9;&#x9;&#x9;currentRepUsers.add(user);&#xA;&#x9;&#x9;&#x9;this.randomUserType().process(user, evt);&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;&#xA;&#x9;private ActivityNode randomUserType() {&#xA;&#x9;&#x9;return this.userActivityGraphs"/>
