          <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;&#x9;&#x9;double tt = 0.0;&#xA;&#x9;&#x9;users = new ArrayDeque&lt;User>();&#xA;&#x9;&#x9;currentRepUsers = new ArrayList&lt;>();&#xA;&#x9;&#x9;User.resetIdCount();&#xA;&#x9;&#x9;while(tt &lt; Utils.EXEC_TIME) {&#xA;&#x9;&#x9;&#x9;User u = new User(tt);&#xA;&#x9;&#x9;&#x9;if(tt == 0.0) {&#xA;&#x9;&#x9;&#x9;&#x9;currentRepUsers.add(u);&#xA;&#x9;&#x9;&#x9;&#x9;this.randomUserType().process(u);&#xA;&#x9;&#x9;&#x9;} else {&#xA;&#x9;&#x9;&#x9;&#x9;users.add(u);&#xA;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;double iat = "/>
