            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&quot;;&#xA;&#x9;&#x9;this.executedCloudlets.add(cl);&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;@Override&#xA;&#x9;public String toString() {&#xA;&#x9;&#x9;String teadsSCI = String.format(Locale.ENGLISH, &quot;%.3e&quot;, this.executedCloudlets.stream().mapToDouble(ScarfCloudlet::getTeadsSci).sum());&#xA;&#x9;&#x9;String pmSCI = String.format(Locale.ENGLISH, &quot;%.3e&quot;, this.executedCloudlets.stream().mapToDouble(ScarfCloudlet::getPowerModelSci).sum());&#xA;&#x9;&#x9;return name + &quot; (&quot; + tier + &quot;) from &quot; + preferredRegion + &quot; at time &quot; + String.format(Locale.ENGLISH, &quot;%.2f&quot;, startTime) + &quot; s {TeadsSCI = &quot; + teadsSCI + &quot; gCO2eq, PowerModelSCI = &quot; + pmSCI + &quot; gC02eq}&quot; + interactionHistory;&#xA;&#x9;}&#xA;}&#xA;&#xA;class ActivityNode {&#xA;&#x9;private final TriConsumer&lt;EventInfo, User, BiConsumer&lt;EventInfo, User>> value;&#xA;&#x9;private final List&lt;ActivityNode> children = new ArrayList&lt;>();&#xA;&#x9;private final List&lt;Integer> routingWeights = new ArrayList&lt;>();&#xA;&#x9;private static final int DEFAULT_WEIGHT = 100;&#xA;&#x9;&#xA;&#x9;public ActivityNode(TriConsumer&lt;EventInfo, User, BiConsumer&lt;EventInfo, User>> value) {&#xA;&#x9;&#x9;this.value = value;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public void addChild(ActivityNode t){&#xA;&#x9;&#x9;this.children.add(t);&#xA;&#x9;&#x9;this.routingWeights.add(DEFAULT_WEIGHT);&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public void addChild(ActivityNode t, int weight) {&#xA;&#x9;&#x9;this.children.add(t);&#xA;&#x9;&#x9;this.routingWeights.add(weight);&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;private ActivityNode getNext() {&#xA;&#x9;&#x9;if(this.children.size() == 1) {&#xA;&#x9;&#x9;&#x9;return this.children.getFirst();&#xA;&#x9;&#x9;} else {&#xA;&#x9;&#x9;&#x9;int totalWeight = this.routingWeights.stream().mapToInt(Integer::intValue).sum();&#xA;&#x9;&#x9;&#x9;int extractedWeight = Utils.rng.nextInt(totalWeight + 1);&#xA;&#x9;&#x9;&#x9;int runningSum = 0;&#xA;&#x9;&#x9;&#x9;for(int j = 0; j &lt; this.routingWeights.size(); j++) {&#xA;&#x9;&#x9;&#x9;&#x9;runningSum += this.routingWeights.get(j);&#xA;&#x9;&#x9;&#x9;&#x9;if(runningSum >= extractedWeight) return this.children.get(j);&#xA;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;return null;&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;private BiConsumer&lt;EventInfo, User> resolveValue() {&#xA;&#x9;&#x9;if(children.isEmpty()) {&#xA;&#x9;&#x9;&#x9;return null;&#xA;&#x9;&#x9;} else {&#xA;&#x9;&#x9;&#x9;ActivityNode next = getNext();&#xA;&#x9;&#x9;&#x9;assert next != null;&#xA;&#x9;&#x9;&#x9;return (evt, usr) -> next.value.accept(evt, usr, next.resolveValue());&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public void process(User user) {&#xA;&#x9;&#x9;value.accept(null, user, resolveValue());&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public void process(User user, EventInfo evt) {&#xA;&#x9;&#x9;value.accept(evt, user, resolveValue());&#xA;&#x9;}&#xA;}&#xA;&#xA;/* MISCELLANEOUS */&#xA;&#xA;class Utils {&#xA;&#x9;static final int CARBON_SYNC_TAG = 123456;&#xA;&#x9;static final long SEED = System.currentTimeMillis();&#xA;&#x9;static Random rng = new Random(SEED);&#xA;&#x9;static Map&lt;String, Integer> gcis = new HashMap&lt;>();&#xA;&#x9;static final int EXEC_TIME = 3600 * 1000; //MILLISECONDS&#xA;&#x9;static final int REPETITIONS = "/>
