            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&quot;;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;@Override&#xA;&#x9;public String toString() {&#xA;&#x9;&#x9;return name + &quot; (&quot; + tier + &quot;) from &quot; + preferredRegion + &quot; at time &quot; + String.format(&quot;%.2f&quot;, startTime) + &quot; s&quot; + interactionHistory;&#xA;&#x9;}&#xA;}&#xA;&#xA;@FunctionalInterface&#xA;interface TriConsumer&lt;T, U, V> {&#xA;&#x9;void accept(T t, U u, V v);&#xA;}&#xA;&#xA;class ActivityNode {&#xA;&#x9;private TriConsumer&lt;EventInfo, User, BiConsumer&lt;EventInfo, User>> value;&#xA;&#x9;private List&lt;ActivityNode> children = new ArrayList&lt;>();&#xA;&#x9;private List&lt;Integer> routingWeights = new ArrayList&lt;>();&#xA;&#x9;private static int DEFAULT_WEIGHT = 100;&#xA;&#x9;&#xA;&#x9;public ActivityNode(TriConsumer&lt;EventInfo, User, BiConsumer&lt;EventInfo, User>> value) {&#xA;&#x9;&#x9;this.value = value;&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public void addChild(ActivityNode t){&#xA;&#x9;&#x9;this.children.add(t);&#xA;&#x9;&#x9;this.routingWeights.add(DEFAULT_WEIGHT);&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public void addChild(ActivityNode t, int weight) {&#xA;&#x9;&#x9;this.children.add(t);&#xA;&#x9;&#x9;this.routingWeights.add(weight);&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;private ActivityNode getNext() {&#xA;&#x9;&#x9;if(this.children.size() == 1) {&#xA;&#x9;&#x9;&#x9;return this.children.get(0);&#xA;&#x9;&#x9;} else {&#xA;&#x9;&#x9;&#x9;int totalWeight = this.routingWeights.stream().mapToInt(Integer::intValue).sum();&#xA;&#x9;&#x9;&#x9;int extractedWeight = Utils.rng.nextInt(totalWeight + 1);&#xA;&#x9;&#x9;&#x9;int runningSum = 0;&#xA;&#x9;&#x9;&#x9;for(int j = 0; j &lt; this.routingWeights.size(); j++) {&#xA;&#x9;&#x9;&#x9;&#x9;runningSum += this.routingWeights.get(j);&#xA;&#x9;&#x9;&#x9;&#x9;if(runningSum >= extractedWeight) return this.children.get(j);&#xA;&#x9;&#x9;&#x9;}&#xA;&#x9;&#x9;&#x9;return null;&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;private BiConsumer&lt;EventInfo, User> resolveValue() {&#xA;&#x9;&#x9;if(children.isEmpty()) {&#xA;&#x9;&#x9;&#x9;return null;&#xA;&#x9;&#x9;} else {&#xA;&#x9;&#x9;&#x9;ActivityNode next = getNext();&#xA;&#x9;&#x9;&#x9;return (evt, usr) -> next.value.accept(evt, usr, next.resolveValue());&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public void process(User user) {&#xA;&#x9;&#x9;value.accept(null, user, resolveValue());&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;public void process(User user, EventInfo evt) {&#xA;&#x9;&#x9;value.accept(evt, user, resolveValue());&#xA;&#x9;}&#xA;}&#xA;&#xA;class SimulationResult {&#xA;&#x9;&#xA;&#x9;class InteractionResult {&#xA;&#x9;&#x9;String interactionName;&#xA;&#x9;&#x9;double avgSCI;&#xA;&#x9;&#x9;double avgServiceTime;&#xA;&#x9;&#x9;long throughput;&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;@Override&#xA;&#x9;&#x9;public String toString() {&#xA;&#x9;&#x9;&#x9;return &quot;i:&quot; + interactionName + &quot;,SCI:&quot; + avgSCI + &quot;,ServiceTime:&quot; + avgServiceTime + &quot;,tp:&quot; + throughput;&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;class DeviceResult {&#xA;&#x9;&#x9;String deviceName;&#xA;&#x9;&#x9;double avgSCI;&#xA;&#x9;&#x9;double avgServiceTime;&#xA;&#x9;&#x9;long throughput;&#xA;&#x9;&#x9;double avgUtilization;&#xA;&#x9;&#x9;long droppedConnections;&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;@Override&#xA;&#x9;&#x9;public String toString() {&#xA;&#x9;&#x9;&#x9;return &quot;d:&quot; + deviceName + &quot;,SCI:&quot; + avgSCI + &quot;,ServiceTime:&quot; + avgServiceTime + &quot;,tp:&quot; + throughput + &quot;,u:&quot; + avgUtilization + &quot;,drop:&quot; + droppedConnections;&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;List&lt;InteractionResult> interactionResults = new ArrayList&lt;>();&#xA;&#x9;List&lt;DeviceResult> deviceResults = new ArrayList&lt;>();&#xA;&#x9;&#xA;&#x9;public SimulationResult(List&lt;ScarfCloudlet> cloudletList, List&lt;ScarfHost> hostRecap) {&#xA;&#x9;&#x9;List&lt;ScarfCloudlet> finishedCloudlets = cloudletList.stream().filter(c -> c.getStatus().equals(Cloudlet.Status.SUCCESS)).collect(Collectors.toList());&#xA;&#x9;&#x9;for (ScarfHost scarfHost : hostRecap) {&#xA;&#x9;&#x9;&#x9;String hostName = scarfHost.getName();&#xA;&#x9;&#x9;&#x9;DeviceResult dr = new DeviceResult();&#xA;&#x9;&#x9;&#x9;dr.deviceName = hostName;&#xA;&#x9;&#x9;&#x9;dr.avgUtilization = scarfHost.myUtil();&#xA;&#x9;&#x9;&#x9;dr.avgSCI = scarfHost.getTeadsSci();&#xA;&#x9;&#x9;&#x9;dr.throughput = finishedCloudlets.stream().filter(c -> ((ScarfVm) c.getVm()).getTargetHost().getName().equals(hostName)).count();&#xA;&#x9;&#x9;&#x9;dr.avgServiceTime = finishedCloudlets.stream().filter(c -> ((ScarfVm) c.getVm()).getTargetHost().getName().equals(hostName)).mapToDouble(Cloudlet::getTotalExecutionTime).average().orElse(0.0);&#xA;&#x9;&#x9;&#x9;dr.droppedConnections = cloudletList.stream().filter(c -> c.getStatus().equals(Cloudlet.Status.QUEUED) &amp;&amp; ((ScarfVm) c.getVm()).getTargetHost().equals(hostName)).map(ScarfCloudlet::getUser).distinct().count();&#xA;&#x9;&#x9;&#x9;deviceResults.add(dr);&#xA;&#x9;&#x9;}&#xA;&#x9;&#x9;for (String interactionName : finishedCloudlets.stream().map(ScarfCloudlet::getInteraction).distinct().collect(Collectors.toList())) {&#xA;&#x9;&#x9;&#x9;InteractionResult ir = new InteractionResult();&#xA;&#x9;&#x9;&#x9;ir.interactionName = interactionName;&#xA;&#x9;&#x9;&#x9;ir.avgSCI = finishedCloudlets.stream().filter(c -> c.getInteraction().equals(interactionName)).mapToDouble(ScarfCloudlet::getTeadsSci).average().orElse(0.0);&#xA;&#x9;&#x9;&#x9;ir.avgServiceTime = finishedCloudlets.stream().filter(c -> c.getInteraction().equals(interactionName)).mapToDouble(Cloudlet::getTotalExecutionTime).average().orElse(0.0);&#xA;&#x9;&#x9;&#x9;ir.throughput = finishedCloudlets.stream().filter(c -> c.getInteraction().equals(interactionName)).map(ScarfCloudlet::getUser).distinct().count();&#xA;&#x9;&#x9;&#x9;interactionResults.add(ir);&#xA;&#x9;&#x9;}&#xA;&#x9;}&#xA;}&#xA;&#xA;class ResultSummary {&#xA;    public Map&lt;String, InteractionMetrics> interactions = new LinkedHashMap&lt;>();&#xA;    public Map&lt;String, ServerMetrics> servers = new LinkedHashMap&lt;>();&#xA;}&#xA;&#xA;class InteractionMetrics {&#xA;    @JsonProperty(&quot;SCI&quot;)&#xA;    public double sci;&#xA;    @JsonProperty(&quot;Service Time&quot;)&#xA;    public double serviceTime;&#xA;    @JsonProperty(&quot;Throughput&quot;)&#xA;    public double throughput;&#xA;}&#xA;&#xA;class ServerMetrics {&#xA;    @JsonProperty(&quot;SCI&quot;)&#xA;    public double sci;&#xA;    @JsonProperty(&quot;Service Time&quot;)&#xA;    public double serviceTime;&#xA;    @JsonProperty(&quot;Throughput&quot;)&#xA;    public double throughput;&#xA;    @JsonProperty(&quot;Utilization&quot;)&#xA;    public double utilization;&#xA;    @JsonProperty(&quot;Dropped Connections&quot;)&#xA;    public double droppedConnections;&#xA;}&#xA;&#xA;class Metadata {&#xA;&#x9;@JsonProperty(&quot;expName&quot;)&#xA;&#x9;String expName;&#xA;&#x9;@JsonProperty(&quot;replications&quot;)&#xA;&#x9;int replications;&#xA;&#x9;@JsonProperty(&quot;duration&quot;)&#xA;&#x9;double duration;&#xA;&#x9;@JsonProperty(&quot;seed&quot;)&#xA;&#x9;long seed;&#xA;}&#xA;&#xA;class ExperimentResults {&#xA;&#x9;@JsonProperty(&quot;metadata&quot;)&#xA;&#x9;Metadata metadata;&#xA;&#x9;@JsonProperty(&quot;interactions&quot;)&#xA;&#x9;List&lt;Map&lt;String, Object>> interactions = new ArrayList&lt;>();&#xA;&#x9;@JsonProperty(&quot;servers&quot;)&#xA;&#x9;List&lt;Map&lt;String, Object>> servers = new ArrayList&lt;>();&#xA;}&#xA;&#xA;class Utils {&#xA;&#x9;static final int CARBON_SYNC_TAG = 123456;&#xA;&#x9;static final long SEED = System.currentTimeMillis();&#xA;&#x9;static Random rng = new Random(SEED);&#xA;&#x9;static Map&lt;String, Integer> gcis = new HashMap&lt;>();&#xA;&#x9;static final int EXEC_TIME = 3600;&#xA;&#x9;static final int REPETITIONS = "/>
